---
// src/components/Nav.astro

// Obtenemos la ruta actual para iluminar el link activo
const pathname = Astro.url.pathname;
// Normalizamos para quitar barra final si hay (excepto en inicio "/")
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;
---

<nav class="sticky top-0 z-50 w-full bg-[#0F172A]/90 backdrop-blur-md border-b border-white/5 py-3 md:py-4 px-4 md:px-8 flex items-center justify-between">
  
  <!-- === MOBILE LAYOUT (Default) === -->
  <div class="flex items-center justify-start md:hidden flex-1 h-8">
    <div id="mobile-auth-loading" class="w-8 h-8 rounded-full bg-slate-800 animate-pulse"></div>
    <a href="/login" id="mobile-login-btn" class="hidden flex-shrink-0 text-[11px] font-bold text-slate-200 border border-white/10 px-3 py-1.5 rounded-full hover:bg-white/10 transition-colors">Entrar</a>
    <a href="/perfil" id="mobile-user-nav" class="hidden w-8 h-8 items-center justify-center rounded-full overflow-hidden border-2 border-transparent hover:border-[#00A3FF] transition-colors">
      <img id="mobile-avatar-img" src="" alt="User Profile" class="w-full h-full object-cover" />
    </a>
  </div>

  <div class="flex items-center justify-center md:hidden shrink-0">
    <span class="font-bold text-sm tracking-widest uppercase">Freedom Movement Lab</span>
  </div>

  <!-- === DESKTOP LAYOUT (md:) === -->
  <div class="hidden md:flex items-center gap-6 lg:gap-10">
    <a href="/" class="flex items-center gap-2 group">
      <svg class="w-8 h-8 text-[#00A3FF] group-hover:text-[#00E5FF] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M12 2v2"/>
      </svg>
      <span class="font-bold text-lg tracking-wide uppercase">Freedom Movement Lab</span>
    </a>

    <div class="flex items-center gap-4 lg:gap-6 text-sm font-medium">
      <a href="/catalogo" class={`transition-colors ${currentPath.startsWith('/catalogo') ? 'text-white' : 'text-slate-300 hover:text-[#00A3FF]'}`}>Catálogo</a>
      <a href="/entrenamiento" class={`transition-colors ${currentPath.startsWith('/entrenamiento') ? 'text-white' : 'text-slate-300 hover:text-[#00A3FF]'}`}>Mi entrenamiento</a>
      <a href="/comunidad" class={`transition-colors ${currentPath.startsWith('/comunidad') ? 'text-white' : 'text-slate-300 hover:text-[#00A3FF]'}`}>Comunidad</a>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 md:gap-5 flex-1 md:flex-none">
    <button id="mobile-search-btn" class="md:hidden text-slate-300 hover:text-white transition-colors p-1">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
    </button>
    
    <div id="desktop-search-bar" class="relative hidden lg:block">
      <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input type="text" id="desktop-search-input" placeholder={currentPath.startsWith('/comunidad') ? "    Buscar publicación..." : "    Buscar movimientos..."} data-context={currentPath.startsWith('/comunidad') ? 'comunidad' : 'catalogo'} autocomplete="off" class="input-dark w-64 pl-10 text-sm focus:outline-none focus:ring-1 focus:ring-[#00A3FF]" />
      <ul id="desktop-search-results" class="hidden absolute top-full left-0 w-full mt-2 bg-[#182538] border border-white/10 rounded-xl shadow-2xl z-50 max-h-80 overflow-y-auto divide-y divide-white/5 text-sm"></ul>
    </div>

    <div class="relative hidden items-center" id="notifications-wrapper">
      <button id="noti-btn" class="text-slate-300 hover:text-white transition-colors relative flex items-center justify-center p-1 md:p-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
        </svg>
        <span id="noti-dot-pulse" class="absolute top-[2px] right-[2px] md:top-0 md:right-0 w-2 h-2 bg-red-500 rounded-full animate-pulse blur-[1px] hidden"></span>
        <span id="noti-dot-solid" class="absolute top-[2px] right-[2px] md:top-0 md:right-0 w-2 h-2 bg-red-500 rounded-full hidden"></span>
      </button>

      <div id="noti-dropdown" class="absolute right-0 top-full mt-2 w-[calc(100vw-2rem)] sm:w-80 max-w-[320px] bg-gray-900 border border-white/10 rounded-lg shadow-lg opacity-0 invisible transform scale-95 transition-all duration-200 origin-top-right z-50">
        <div class="px-4 py-3 border-b border-white/5 flex items-center justify-between">
          <h3 class="font-bold text-white text-sm">Notificaciones</h3>
          <div class="flex items-center gap-3">
            <span id="noti-badge-count" class="text-[10px] font-bold text-[#00A3FF] hidden">0 nuevas</span>
            <button id="btn-marcar-vistas" class="text-[10px] text-slate-400 hover:text-[#00A3FF] font-semibold transition-colors hidden">Marcar como vistas</button>
          </div>
        </div>
        <div id="noti-list" class="max-h-[300px] overflow-y-auto">
          <div id="noti-loading" class="p-4 space-y-4">
            <div class="animate-pulse flex space-x-4 w-full">
              <div class="rounded-lg bg-slate-700 h-10 w-16"></div>
              <div class="flex-1 space-y-2 py-1"><div class="h-2 bg-slate-700 rounded w-3/4"></div></div>
            </div>
          </div>
        </div>
        <div class="p-3 text-center border-t border-white/5 bg-black/20 rounded-b-xl">
           <a href="/catalogo#siguiendo" class="text-xs font-semibold text-slate-400 hover:text-white transition-colors">Ver instructores que sigues</a>
        </div>
      </div>
    </div>
    
    <div id="desktop-auth-loading" class="hidden w-9 h-9 rounded-full bg-slate-800 animate-pulse"></div>
    <a href="/login" id="desktop-login-btn" class="hidden bg-white text-black hover:bg-slate-200 text-sm font-bold px-4 py-2 rounded-full transition-colors items-center gap-2 shadow-lg shadow-white/10">Acceder</a>
    <a href="/perfil" id="desktop-user-nav" class="hidden w-9 h-9 items-center justify-center rounded-full overflow-hidden border-2 border-transparent hover:border-[#00A3FF] transition-colors">
      <img id="desktop-avatar-img" src="" alt="User Profile" class="w-full h-full object-cover" />
    </a>
  </div>

  <div id="mobile-search-container" class="hidden absolute inset-0 bg-[#0F172A] z-50 flex items-center px-4 gap-3">
    <input type="text" id="mobile-search-input" placeholder={currentPath.startsWith('/comunidad') ? "Buscar publicación..." : "Buscar movimientos..."} data-context={currentPath.startsWith('/comunidad') ? 'comunidad' : 'catalogo'} autocomplete="off" class="flex-1 bg-transparent text-white focus:outline-none text-base h-full py-4" />
    <button id="btn-close-mobile-search" class="text-slate-400 hover:text-white shrink-0 p-2 text-sm font-bold">✕</button>
    <ul id="mobile-search-results" class="hidden absolute top-full left-0 w-full bg-[#182538] border-b border-white/10 shadow-2xl z-50 max-h-[60vh] overflow-y-auto divide-y divide-white/5 text-sm"></ul>
  </div>
</nav>

<dialog id="modal-appeal" class="bg-[#0b1016] text-white border border-white/10 rounded-3xl p-8 shadow-2xl backdrop-blur-xl w-[90%] max-w-[450px] m-auto">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-12 h-12 bg-blue-500/20 text-blue-500 rounded-2xl flex items-center justify-center">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
    </div>
    <div>
      <h2 class="text-xl font-black uppercase tracking-tight">Apelar Sanción</h2>
      <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">Tu oportunidad de aclarar lo sucedido</p>
    </div>
  </div>
  <form id="form-appeal" class="space-y-4">
    <input type="hidden" id="appeal-infraction-id">
    <input type="hidden" id="appeal-noti-id">
    <textarea id="appeal-text" rows="5" required placeholder="Escribe aquí tus motivos..." class="w-full bg-[#111C2A] border border-white/10 text-white p-4 rounded-2xl focus:outline-none focus:border-blue-500 transition-colors resize-none text-sm"></textarea>
    <div class="flex justify-end gap-3 mt-4">
      <button type="button" onclick="this.closest('dialog').close()" class="text-slate-400 text-[10px] font-black uppercase tracking-widest">Cerrar</button>
      <button type="submit" id="btn-submit-appeal" class="px-6 py-2.5 bg-blue-500 text-black font-black text-[10px] rounded-xl uppercase tracking-widest">Enviar</button>
    </div>
  </form>
</dialog>

<script>
  import { supabase } from '../lib/supabase';

  const notiWrapper = document.getElementById('notifications-wrapper');
  const mobileLoading = document.getElementById('mobile-auth-loading');
  const mobileLoginBtn = document.getElementById('mobile-login-btn');
  const mobileUserNav = document.getElementById('mobile-user-nav');
  const mobileAvatarImg = document.getElementById('mobile-avatar-img') as HTMLImageElement;
  const desktopLoading = document.getElementById('desktop-auth-loading');
  const desktopLoginBtn = document.getElementById('desktop-login-btn');
  const desktopUserNav = document.getElementById('desktop-user-nav');
  const desktopAvatarImg = document.getElementById('desktop-avatar-img') as HTMLImageElement;

  async function checkUser() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if(mobileLoading) mobileLoading.classList.add('hidden');
      if(desktopLoading) desktopLoading.classList.add('hidden');

      if (session && session.user) {
        const meta = session.user.user_metadata;
        const defaultName = meta?.full_name || session.user.email?.split('@')[0] || 'Usuario';
        const avatarUrl = meta?.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(defaultName)}&background=00A3FF&color=fff`;

        if(mobileAvatarImg) mobileAvatarImg.src = avatarUrl;
        if(desktopAvatarImg) desktopAvatarImg.src = avatarUrl;

        const isPerfil = window.location.pathname.startsWith('/perfil');
        if (!isPerfil) {
          mobileUserNav?.classList.remove('hidden'); mobileUserNav?.classList.add('flex');
          desktopUserNav?.classList.remove('hidden'); desktopUserNav?.classList.add('flex');
        }
        notiWrapper?.classList.remove('hidden'); notiWrapper?.classList.add('flex');
      } else {
        mobileLoginBtn?.classList.remove('hidden'); mobileLoginBtn?.classList.add('flex');
        desktopLoginBtn?.classList.remove('hidden'); desktopLoginBtn?.classList.add('flex');
      }
    } catch(e) {}
  }
  checkUser();

  // Dropdown
  const btn = document.getElementById('noti-btn');
  const dropdown = document.getElementById('noti-dropdown');
  let notificacionesCargadas = false;

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = !dropdown?.classList.contains('opacity-0');
    if (isExpanded) {
      // Cerrar
      dropdown?.classList.add('opacity-0', 'invisible', 'scale-95');
      dropdown?.classList.remove('opacity-100', 'visible', 'scale-100');
    } else {
      // Abrir
      dropdown?.classList.remove('opacity-0', 'invisible', 'scale-95');
      dropdown?.classList.add('opacity-100', 'visible', 'scale-100');
      if (!notificacionesCargadas) { cargarNotificacionesDropdown(); notificacionesCargadas = true; }
    }
  });

  document.addEventListener('click', (e) => {
    if (dropdown && !dropdown.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
      dropdown.classList.add('opacity-0', 'invisible', 'scale-95');
      dropdown.classList.remove('opacity-100', 'visible', 'scale-100');
    }
  });

  function tiempoRelativoNav(fechaStr: string): string {
    const ahora = new Date();
    const fecha = new Date(fechaStr);
    const diffMs = ahora.getTime() - fecha.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    if (diffMins < 60) return `Hace ${diffMins} min`;
    const diffHoras = Math.floor(diffMins / 60);
    if (diffHoras < 24) return `Hace ${diffHoras}h`;
    return fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
  }

  async function cargarNotificacionesDropdown() {
    const notiList = document.getElementById('noti-list');
    const notiBadge = document.getElementById('noti-badge-count');
    if (!notiList) return;

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;
      const uid = session.user.id;

      const { data: perf } = await supabase.from('perfiles').select('rol').eq('id', uid).single();
      const isStaff = perf?.rol === 'admin' || perf?.rol === 'instructor';

      const { data: userNotis } = await supabase.from('user_notifications').select('*').eq('user_id', uid).eq('is_read', false).order('created_at', { ascending: false });
      let staffNotis = [];
      if (isStaff) {
        const { data } = await supabase.from('forum_report_notifications').select('*, report:vw_forum_reports(*)').eq('user_id', uid).eq('is_read', false).limit(10);
        staffNotis = data || [];
      }

      const total = (userNotis?.length || 0) + staffNotis.length;
      if (notiBadge) {
        if (total > 0) { notiBadge.textContent = total.toString(); notiBadge.classList.remove('hidden'); }
        else { notiBadge.classList.add('hidden'); }
      }

      if (total === 0) {
        notiList.innerHTML = '<div class="p-6 text-center text-xs text-slate-500 uppercase font-bold tracking-widest">Todo al día</div>';
        return;
      }

      let html = '<div class="p-3 space-y-3">';
      if (userNotis?.length) {
        html += userNotis.map(n => `
          <div class="p-3 bg-rose-500/5 border border-rose-500/10 rounded-xl">
            <h4 class="text-xs font-black text-white uppercase">${n.title}</h4>
            <p class="text-[10px] text-slate-400 mt-1">${n.content}</p>
            <div class="flex gap-2 mt-2">
              <button class="btn-noti-action flex-1 py-1 bg-white/10 text-white text-[8px] font-black rounded uppercase" data-id="${n.id}" data-action="accept">Aceptar</button>
            </div>
          </div>
        `).join('');
      }
      if (staffNotis.length) {
        html += staffNotis.map(n => `
          <a href="/comunidad/configuracion" class="noti-report-item block p-3 bg-amber-500/5 border border-amber-500/10 rounded-xl" data-id="${n.id}">
            <p class="text-[9px] font-black text-amber-500 uppercase">${n.report?.title || 'Reporte'}</p>
            <p class="text-[10px] text-slate-300 mt-0.5">${n.report?.reporter_name} -> ${n.report?.reported_name}</p>
          </a>
        `).join('');
      }
      html += '</div>';
      notiList.innerHTML = html;

      // Listeners
      document.querySelectorAll('.btn-noti-action').forEach(b => b.addEventListener('click', async (e) => {
        const id = (b as HTMLElement).dataset.id;
        await supabase.from('user_notifications').update({ is_read: true }).eq('id', id);
        cargarNotificacionesDropdown();
      }));
      document.querySelectorAll('.noti-report-item').forEach(b => b.addEventListener('click', async (e) => {
        const id = (b as HTMLElement).dataset.id;
        await supabase.from('forum_report_notifications').update({ is_read: true }).eq('id', id);
      }));

    } catch (e) {}
  }

  // Search
  const searchInputs = document.querySelectorAll('input[data-context]');
  searchInputs.forEach(inp => {
    const el = inp as HTMLInputElement;
    const res = document.getElementById(el.id === 'mobile-search-input' ? 'mobile-search-results' : 'desktop-search-results');
    let t: any;
    el.addEventListener('input', () => {
      clearTimeout(t);
      if (el.value.length < 2) { res?.classList.add('hidden'); return; }
      t = setTimeout(async () => {
        if (res) { res.innerHTML = '<li class="p-4 text-xs text-center text-slate-400">Buscando...</li>'; res.classList.remove('hidden'); }
        const { data } = await supabase.from('forum_threads').select('id, title').ilike('title', `%${el.value}%`).limit(5);
        if (res) res.innerHTML = data?.length ? data.map(d => `<a href="/comunidad/hilo/${d.id}" class="block p-3 hover:bg-white/5 text-sm text-slate-200">${d.title}</a>`).join('') : '<li class="p-4 text-xs text-center text-slate-500 italic">No hay resultados</li>';
      }, 400);
    });
  });

  // Mobile search toggle
  const msB = document.getElementById('mobile-search-btn');
  const msC = document.getElementById('mobile-search-container');
  msB?.addEventListener('click', () => { msC?.classList.remove('hidden'); (document.getElementById('mobile-search-input') as HTMLInputElement)?.focus(); });
  document.getElementById('btn-close-mobile-search')?.addEventListener('click', () => msC?.classList.add('hidden'));

  // Appeal form
  document.getElementById('form-appeal')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const mid = (f.querySelector('#appeal-infraction-id') as HTMLInputElement).value;
    const nid = (f.querySelector('#appeal-noti-id') as HTMLInputElement).value;
    const txt = (f.querySelector('#appeal-text') as HTMLTextAreaElement).value;
    await supabase.from('user_infractions').update({ appeal_message: txt, appeal_status: 'pending' }).eq('id', mid);
    await supabase.from('user_notifications').update({ is_read: true }).eq('id', nid);
    alert('Enviado.'); window.location.reload();
  });
</script>
