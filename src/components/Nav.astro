---
// src/components/Nav.astro
---

<nav class="sticky top-0 z-50 w-full bg-[#0F172A]/90 backdrop-blur-md border-b border-white/5 py-3 md:py-4 px-4 md:px-8 flex items-center justify-between">
  
  <!-- === MOBILE LAYOUT (Default) === -->
  <!-- Left: Avatar / Login (Mobile) -->
  <div class="flex items-center justify-start md:hidden flex-1 h-8">
    <div id="mobile-auth-loading" class="w-8 h-8 rounded-full bg-slate-800 animate-pulse"></div>
    <a href="/login" id="mobile-login-btn" class="hidden flex-shrink-0 text-[11px] font-bold text-slate-200 border border-white/10 px-3 py-1.5 rounded-full hover:bg-white/10 transition-colors">Entrar</a>
    <a href="/perfil" id="mobile-user-nav" class="hidden w-8 h-8 items-center justify-center rounded-full overflow-hidden border-2 border-transparent hover:border-[#00A3FF] transition-colors">
      <img id="mobile-avatar-img" src="" alt="User Profile" class="w-full h-full object-cover" />
    </a>
  </div>

  <!-- Center: Brand Text -->
  <div class="flex items-center justify-center md:hidden shrink-0">
    <span class="font-bold text-sm tracking-widest uppercase">Freedom Movement Lab</span>
  </div>

  <!-- === DESKTOP LAYOUT (md:) === -->
  <!-- Left Links (Desktop) -->
  <div class="hidden md:flex items-center gap-10">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 group">
      <svg class="w-8 h-8 text-[#00A3FF] group-hover:text-[#00E5FF] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 14 4-4"/>
        <path d="M3.34 19a10 10 0 1 1 17.32 0"/>
        <path d="M12 2v2"/>
      </svg>
      <span class="font-bold text-lg tracking-wide uppercase">Freedom Movement Lab</span>
    </a>

    <!-- Links -->
    <div class="flex items-center gap-6 text-sm font-medium text-slate-300">
      <a href="/" class="text-white hover:text-[#00A3FF] transition-colors">Inicio</a>
      <a href="/catalogo" class="hover:text-[#00A3FF] transition-colors">Catálogo</a>
      <a href="/entrenamiento" class="hover:text-[#00A3FF] transition-colors">Mi entrenamiento</a>
    </div>
  </div>

  <!-- Right: Search, Notifications, Desktop Avatar -->
  <!-- On mobile, it acts as the right aligned container (flex-1). On desktop, it aligns right normally -->
  <div class="flex items-center justify-end gap-3 md:gap-5 flex-1 md:flex-none">
    
    <!-- Mobile Search Icon -->
    <button id="mobile-search-btn" class="md:hidden text-slate-300 hover:text-white transition-colors p-1">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
    </button>
    
    <!-- Desktop Search Bar -->
    <div id="desktop-search-bar" class="relative hidden lg:block">
      <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      <!-- Los espacios son para que se vea bien, sin colapsar con el svg -->
      <input type="text" placeholder="    Buscar movimientos..." class="input-dark w-64 pl-10 text-sm" />
    </div>

    <!-- Notification Wrapper -->
    <div class="relative hidden items-center" id="notifications-wrapper">
      <button id="noti-btn" class="text-slate-300 hover:text-white transition-colors relative flex items-center justify-center p-1 md:p-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
        </svg>
        <span class="absolute top-[2px] right-[2px] md:top-0 md:right-0 w-2 h-2 bg-red-500 rounded-full animate-pulse blur-[1px]"></span>
        <span class="absolute top-[2px] right-[2px] md:top-0 md:right-0 w-2 h-2 bg-red-500 rounded-full"></span>
      </button>

      <!-- Popup Dropdown -->
      <div id="noti-dropdown" class="absolute right-0 top-full mt-2 md:mt-4 w-[calc(100vw-2rem)] sm:w-80 max-w-[320px] bg-[#1E293B] border border-white/10 rounded-xl shadow-2xl shadow-black/50 opacity-0 invisible transform scale-95 transition-all duration-200 origin-top-right z-50">
        <!-- Header -->
        <div class="px-4 py-3 border-b border-white/5 flex items-center justify-between">
          <h3 class="font-bold text-white text-sm">Notificaciones</h3>
          <span id="noti-badge-count" class="text-[10px] font-bold text-[#00A3FF] hidden">0 nuevas</span>
        </div>
        
        <!-- List (contenido dinámico) -->
        <div id="noti-list" class="max-h-[300px] overflow-y-auto">
          <!-- Estado de carga -->
          <div id="noti-loading" class="p-6 text-center">
            <div class="w-5 h-5 border-2 border-[#00A3FF] border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            <p class="text-xs text-slate-500">Cargando...</p>
          </div>
        </div>
        
        <!-- Footer -->
        <div class="p-3 text-center border-t border-white/5 bg-black/20 rounded-b-xl">
           <a href="/catalogo#siguiendo" class="text-xs font-semibold text-slate-400 hover:text-white transition-colors">Ver instructores que sigues</a>
        </div>
      </div>
    </div>
    
    <!-- Desktop Auth Loading -->
    <div id="desktop-auth-loading" class="hidden md:block w-9 h-9 rounded-full bg-slate-800 animate-pulse"></div>

    <a href="/login" id="desktop-login-btn" class="hidden bg-white text-black hover:bg-slate-200 text-sm font-bold px-4 py-2 rounded-full transition-colors items-center gap-2 shadow-lg shadow-white/10">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
      Acceder
    </a>
    
    <!-- Profile Avatar (Desktop) -->
    <a href="/perfil" id="desktop-user-nav" class="hidden w-9 h-9 items-center justify-center rounded-full overflow-hidden border-2 border-transparent hover:border-[#00A3FF] transition-colors">
      <img id="desktop-avatar-img" src="" alt="User Profile" class="w-full h-full object-cover" />
    </a>
  </div>
</nav>

<script>
  import { supabase, loginConGoogle } from '../lib/supabase';

  // --- Lógica de Autenticación y Estado ---
  const notiWrapper = document.getElementById('notifications-wrapper');
  
  const mobileLoading = document.getElementById('mobile-auth-loading');
  const mobileLoginBtn = document.getElementById('mobile-login-btn');
  const mobileUserNav = document.getElementById('mobile-user-nav');
  const mobileAvatarImg = document.getElementById('mobile-avatar-img') as HTMLImageElement;

  const desktopLoading = document.getElementById('desktop-auth-loading');
  const desktopLoginBtn = document.getElementById('desktop-login-btn');
  const desktopUserNav = document.getElementById('desktop-user-nav');
  const desktopAvatarImg = document.getElementById('desktop-avatar-img') as HTMLImageElement;

  // --- Ocultar búsqueda en la página de perfil (antes de auth) ---
  const isPerfil = window.location.pathname.startsWith('/perfil');
  if (isPerfil) {
    const mobileSearchBtn = document.getElementById('mobile-search-btn');
    const desktopSearchBar = document.getElementById('desktop-search-bar');
    if (mobileSearchBtn) mobileSearchBtn.style.display = 'none';
    if (desktopSearchBar) desktopSearchBar.style.display = 'none';
  }

  // --- Lógica de Autenticación y Estado ---

  async function checkUser() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      
      // Ocultar loaders iniciales
      if(mobileLoading) mobileLoading.classList.add('hidden');
      if(desktopLoading) desktopLoading.classList.add('hidden');
      if(desktopLoading) desktopLoading.classList.remove('md:block');

      if (session && session.user) {
        // Usuario Logueado
        const meta = session.user.user_metadata;
        const defaultName = meta?.full_name || session.user.email?.split('@')[0] || 'Usuario';
        const avatarUrl = meta?.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(defaultName)}&background=00A3FF&color=fff`;

        if(mobileAvatarImg) mobileAvatarImg.src = avatarUrl;
        if(desktopAvatarImg) desktopAvatarImg.src = avatarUrl;

        // Revelar UI dinámica solo si NO estamos en la página del perfil
        const isPerfil = window.location.pathname.startsWith('/perfil');
        if (!isPerfil) {
          if (mobileUserNav) { 
            mobileUserNav.classList.remove('hidden'); 
            mobileUserNav.classList.add('flex'); 
          }
          if (desktopUserNav) { 
            desktopUserNav.classList.remove('hidden'); 
            desktopUserNav.classList.add('hidden', 'md:flex'); 
          }
        } else {
          // Estamos en el perfil: la búsqueda ya se ocultó arriba
        }
        
        if (notiWrapper) { 
          notiWrapper.classList.remove('hidden'); 
          notiWrapper.classList.add('flex'); 
        }
        
      } else {
        // Visitante
        if(mobileLoginBtn) mobileLoginBtn.classList.remove('hidden');
        if(desktopLoginBtn) { desktopLoginBtn.classList.remove('hidden'); desktopLoginBtn.classList.add('md:flex'); }
      }
    } catch(e) {
      console.error('Error on auth load:', e);
    }
  }

  // Eliminar onAuthStateChange previene el bucle infinito al recargar.
  // checkUser se encarga de cambiar la UI en 0.1s tras cargar el DOM
  checkUser();

  // --- Lógica del Dropdown de notificaciones ---
  const btn = document.getElementById('noti-btn');
  const dropdown = document.getElementById('noti-dropdown');
  let notificacionesCargadas = false;

  if (btn && dropdown) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = !dropdown.classList.contains('opacity-0');
      
      if (isExpanded) {
        // Cerrar
        dropdown.classList.add('opacity-0', 'invisible', 'scale-95');
        dropdown.classList.remove('opacity-100', 'visible', 'scale-100');
      } else {
        // Abrir
        dropdown.classList.remove('opacity-0', 'invisible', 'scale-95');
        dropdown.classList.add('opacity-100', 'visible', 'scale-100');
        
        // Cargar notificaciones al abrir por primera vez
        if (!notificacionesCargadas) {
          cargarNotificacionesDropdown();
          notificacionesCargadas = true;
        }
      }
    });

    // Cerrar si se hace click fuera
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        dropdown.classList.add('opacity-0', 'invisible', 'scale-95');
        dropdown.classList.remove('opacity-100', 'visible', 'scale-100');
      }
    });
  }

  // --- Carga dinámica de notificaciones desde seguimientos + vídeos ---
  function tiempoRelativoNav(fechaStr: string): string {
    const ahora = new Date();
    const fecha = new Date(fechaStr);
    const diffMs = ahora.getTime() - fecha.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHoras = Math.floor(diffMins / 60);
    const diffDias = Math.floor(diffHoras / 24);

    if (diffMins < 1) return 'Ahora mismo';
    if (diffMins < 60) return `Hace ${diffMins} min`;
    if (diffHoras < 24) return `Hace ${diffHoras}h`;
    if (diffDias === 1) return 'Ayer';
    if (diffDias < 7) return `Hace ${diffDias} días`;
    if (diffDias < 30) return `Hace ${Math.floor(diffDias / 7)} semana${Math.floor(diffDias / 7) > 1 ? 's' : ''}`;
    return fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
  }

  async function cargarNotificacionesDropdown() {
    const notiList = document.getElementById('noti-list');
    const notiLoading = document.getElementById('noti-loading');
    const notiBadge = document.getElementById('noti-badge-count');
    const redDots = btn?.querySelectorAll('span.bg-red-500');

    if (!notiList) return;

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) {
        notiList.innerHTML = `
          <div class="p-6 text-center">
            <p class="text-sm text-slate-400">Inicia sesión para ver notificaciones.</p>
          </div>`;
        return;
      }

      // 1. Obtener instructores seguidos
      const { data: seguimientos, error: segError } = await supabase
        .from('seguimientos')
        .select('instructor_nombre')
        .eq('usuario_id', session.user.id);

      if (segError || !seguimientos || seguimientos.length === 0) {
        notiList.innerHTML = `
          <div class="p-6 text-center">
            <svg class="w-8 h-8 text-slate-600 mx-auto mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
            <p class="text-sm text-slate-400 mb-1">Sin notificaciones</p>
            <p class="text-xs text-slate-500">Sigue instructores en el catálogo para recibir alertas de nuevos vídeos.</p>
          </div>`;
        // Ocultar punto rojo
        redDots?.forEach(d => (d as HTMLElement).style.display = 'none');
        return;
      }

      const nombresInstructores = seguimientos.map(s => s.instructor_nombre);

      // 2. Obtener vídeos recientes de esos instructores
      const { data: videos, error: vidError } = await supabase
        .from('videos')
        .select('id, titulo, instructor, creado_en, mux_playback_id')
        .eq('estado', 'listo')
        .in('instructor', nombresInstructores)
        .order('creado_en', { ascending: false })
        .limit(10);

      if (vidError || !videos || videos.length === 0) {
        notiList.innerHTML = `
          <div class="p-6 text-center">
            <p class="text-sm text-slate-400 mb-1">Todo al día</p>
            <p class="text-xs text-slate-500">Tus instructores seguidos no han publicado vídeos recientes.</p>
          </div>`;
        redDots?.forEach(d => (d as HTMLElement).style.display = 'none');
        return;
      }

      // 3. Contar nuevos (<3 días)
      const tresDiasMs = 86400000 * 3;
      const ahora = new Date().getTime();
      const nuevos = videos.filter((v: any) => (ahora - new Date(v.creado_en).getTime()) < tresDiasMs).length;

      if (notiBadge && nuevos > 0) {
        notiBadge.textContent = `${nuevos} nueva${nuevos > 1 ? 's' : ''}`;
        notiBadge.classList.remove('hidden');
      }

      if (nuevos === 0) {
        redDots?.forEach(d => (d as HTMLElement).style.display = 'none');
      }

      // 4. Renderizar lista
      let html = '';
      videos.forEach((v: any, i: number) => {
        const esNuevo = (ahora - new Date(v.creado_en).getTime()) < tresDiasMs;
        const thumb = v.mux_playback_id 
          ? `https://image.mux.com/${v.mux_playback_id}/thumbnail.webp?time=1&width=80&height=45` 
          : '';
        const bordeBottom = i < videos.length - 1 ? 'border-b border-white/5' : '';
        const bgClass = esNuevo ? 'bg-white/5 hover:bg-white/10' : 'hover:bg-white/5';

        html += `
          <a href="/reproductor?id=${v.id}" class="block p-3 ${bordeBottom} ${bgClass} transition-colors">
            <div class="flex gap-3">
              ${thumb ? `
                <div class="w-16 h-10 rounded-lg overflow-hidden flex-shrink-0 border border-white/5">
                  <img src="${thumb}" alt="" class="w-full h-full object-cover" />
                </div>
              ` : `
                <div class="w-2 h-2 mt-1.5 rounded-full ${esNuevo ? 'bg-[#00A3FF]' : 'bg-transparent'} flex-shrink-0"></div>
              `}
              <div class="min-w-0">
                <p class="text-sm ${esNuevo ? 'text-slate-200' : 'text-slate-300'} leading-snug">
                  <span class="font-bold ${esNuevo ? 'text-white' : 'text-slate-200'}">${v.instructor}</span> ha publicado
                </p>
                <p class="text-xs ${esNuevo ? 'text-[#00A3FF]' : 'text-slate-400'} font-medium truncate mt-0.5">${v.titulo}</p>
                <p class="text-[10px] text-slate-500 mt-1">${tiempoRelativoNav(v.creado_en)}</p>
              </div>
            </div>
          </a>
        `;
      });

      notiList.innerHTML = html;

    } catch (e) {
      console.error('Error cargando notificaciones:', e);
      notiList.innerHTML = `
        <div class="p-6 text-center">
          <p class="text-sm text-slate-400">No se pudieron cargar las notificaciones.</p>
        </div>`;
    }
  }

</script>
