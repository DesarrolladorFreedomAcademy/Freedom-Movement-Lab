---
// src/components/BottomNav.astro
const currentPath = Astro.url.pathname;
---

<nav class="md:hidden fixed bottom-0 left-0 w-full bg-[#0F172A]/90 backdrop-blur-lg border-t border-white/5 z-50 px-6 py-3 pb-safe">
  <div class="flex items-center justify-between">
    <!-- Home -->
    <a href="/" class={`flex flex-col items-center gap-1 transition-colors ${currentPath === '/' ? 'text-[#00A3FF]' : 'text-slate-500 hover:text-slate-300'}`}>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="text-[10px] font-semibold">Inicio</span>
    </a>
    
    <!-- Browse / Catálogo -->
    <a href="/catalogo" class={`flex flex-col items-center gap-1 transition-colors ${currentPath.includes('/catalogo') ? 'text-[#00A3FF]' : 'text-slate-500 hover:text-slate-300'}`}>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
      <span class="text-[10px] font-semibold">Catálogo</span>
    </a>
    
    <!-- Library / Mi entrenamiento -->
    <a href="/entrenamiento" class={`flex flex-col items-center gap-1 transition-colors ${currentPath.includes('/entrenamiento') ? 'text-[#00A3FF]' : 'text-slate-500 hover:text-slate-300'}`}>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      <span class="text-[10px] font-semibold">Biblioteca</span>
    </a>

     <!-- Descargas (Mock) - Oculto por ahora -->
    <a href="#" class={`hidden flex-col items-center gap-1 transition-colors ${currentPath.includes('/descargas') ? 'text-[#00A3FF]' : 'text-slate-500 hover:text-slate-300'}`}>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <span class="text-[10px] font-semibold">Descargas</span>
    </a>
    
    <!-- Profile -->
    <a href="/perfil" class={`flex flex-col items-center gap-1 transition-colors ${currentPath.includes('/perfil') ? 'text-[#00A3FF]' : 'text-slate-500 hover:text-slate-300'}`}>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span class="text-[10px] font-semibold">Perfil</span>
    </a>
  </div>
</nav>

<style>
  /* Safe padding for modern phones like iPhone */
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 1rem);
  }
</style>
