---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { supabase } from '../../lib/supabase';

// Forzar SSR en Astro
export const prerender = false;

// Obtener categorías
const { data: categories, error: catError } = await supabase
  .from('forum_categories')
  .select('*')
  .order('created_at', { ascending: true });

// Obtener últimos hilos para moderación
const { data: threads, error: threadError } = await supabase
  .from('vw_forum_threads')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(30);

// Obtener denuncias pendientes
const { data: reports, error: reportError } = await supabase
  .from('vw_forum_reports')
  .select('*')
  .eq('status', 'pending')
  .order('created_at', { ascending: false });

---

<Layout title="Administración de Comunidad | Freedom Movement Lab">
  <Nav />
  
  <main class="w-full min-h-screen bg-[#0b1016] text-white pt-24 pb-20">
    <div class="container mx-auto px-6 max-w-5xl animate-fade-in relative">
      
      <!-- Pantalla de Carga / Verificación -->
      <div id="auth-loading" class="flex flex-col items-center justify-center py-20">
        <div class="w-12 h-12 border-4 border-[#00A3FF] border-t-transparent rounded-full animate-spin mb-4"></div>
        <p class="text-slate-400 font-bold uppercase tracking-widest text-sm">Verificando permisos...</p>
      </div>

      <!-- Contenido Protegido (Oculto hasta validar) -->
      <div id="protected-content" class="hidden space-y-12">
        <header class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span id="badge-role" class="px-2 py-1 rounded bg-slate-800 text-slate-300 text-[10px] font-black tracking-widest uppercase"></span>
            </div>
            <h1 class="text-4xl font-black tracking-tight uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#EAB308] to-[#FDE047]">Panel de Moderación</h1>
            <p class="text-slate-400 font-medium">Gestiona la comunidad, las categorías y el contenido publicado.</p>
          </div>
          <div>
            <a href="/comunidad" class="btn-primary flex items-center gap-2 px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white font-bold rounded-lg transition-all border border-white/10">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
              Volver a la Comunidad
            </a>
          </div>
        </header>

        <!-- SECCIÓN: GESTIÓN DE CATEGORÍAS (Sólo ADMIN) -->
        <section id="section-categories" class="hidden bg-[#111C2A] border border-[#00A3FF]/20 rounded-3xl p-8 shadow-xl relative overflow-hidden">
          <svg class="absolute right-[-20px] top-[-20px] w-48 h-48 text-[#00A3FF]/5 rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          
          <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-white/10">
            <div>
              <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                Gestión de Categorías
              </h2>
              <p class="text-xs text-slate-400 mt-1">Crea, edita o elimina las categorías del foro.</p>
            </div>
            <button id="btn-new-category" class="px-4 py-2 bg-[#00A3FF] hover:bg-[#00E5FF] text-black font-bold text-sm rounded-lg transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Nueva Categoría
            </button>
          </div>

          <div id="grid-categories" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 relative z-10">
            {categories?.map((cat) => (
              <div class="bg-[#0b1016] border border-white/5 p-4 rounded-xl flex flex-col justify-between group hover:border-[#00A3FF]/30 transition-colors">
                <div>
                  <h3 class="font-bold text-white mb-1 group-hover:text-[#00A3FF] transition-colors">{cat.name}</h3>
                  <p class="text-xs text-slate-500 line-clamp-2">{cat.description || 'Sin descripción'}</p>
                </div>
                <div class="flex items-center gap-2 mt-4 pt-3 border-t border-white/5">
                  <button class="btn-edit-cat flex-1 py-1.5 px-3 bg-white/5 hover:bg-white/10 text-white text-xs font-bold rounded flex items-center justify-center gap-1 transition-colors" data-id={cat.id} data-name={cat.name} data-desc={cat.description}>
                    Editar
                  </button>
                  <button class="btn-delete-cat px-3 py-1.5 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 rounded text-xs transition-colors" data-id={cat.id} data-name={cat.name}>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </div>
              </div>
            ))}
            {(!categories || categories.length === 0) && (
              <p class="text-sm text-slate-500 col-span-full">No hay categorías configuradas.</p>
            )}
          </div>
        </section>

        <!-- SECCIÓN: MODERACIÓN DE HILOS (ADMIN & TRAINER) -->
        <section class="bg-[#111C2A] border border-white/5 rounded-3xl p-8 shadow-xl">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/10">
            <div>
              <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                Moderación de Hilos Recientes
              </h2>
              <p class="text-xs text-slate-400 mt-1">Supervisa y elimina contenido inapropiado (Muestra los últimos 30 hilos).</p>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-[10px] uppercase font-bold text-slate-500 tracking-wider border-b border-white/10">
                  <th class="pb-3 pl-2">Hilo</th>
                  <th class="pb-3 w-40">Autor</th>
                  <th class="pb-3 w-32">Fecha</th>
                  <th class="pb-3 w-20 text-right pr-2">Acción</th>
                </tr>
              </thead>
              <tbody class="text-sm divide-y divide-white/5">
                {threads?.map((thread) => {
                  const dateFormatted = new Date(thread.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
                  return (
                    <tr class="group hover:bg-white/5 transition-colors" id={`thread-row-${thread.id}`}>
                      <td class="py-4 pl-2 font-medium text-white">
                        <a href={`/comunidad/hilo/${thread.id}`} target="_blank" class="hover:text-[#00A3FF] transition-colors">{thread.title}</a>
                      </td>
                      <td class="py-4 text-slate-400">
                        <div class="flex items-center gap-2">
                          <img src={thread.author_avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(thread.author_name)}&background=111C2A&color=00A3FF`} class="w-6 h-6 rounded-full" alt=""/>
                          <span class="truncate">{thread.author_name}</span>
                        </div>
                      </td>
                      <td class="py-4 text-slate-500 text-xs">{dateFormatted}</td>
                      <td class="py-4 pr-2 text-right">
                        <button class="btn-delete-thread text-slate-500 hover:text-rose-500 p-2 rounded hover:bg-rose-500/10 transition-colors" data-id={thread.id} data-title={thread.title} title="Eliminar hilo">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                      </td>
                    </tr>
                  )
                })}
                {(!threads || threads.length === 0) && (
                  <tr>
                    <td colspan="4" class="py-8 text-center text-slate-500 italic">No hay hilos publicados.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </section>

        <!-- SECCIÓN: GESTIÓN DE DENUNCIAS (ADMIN & TRAINER) -->
        <section id="section-reports" class="bg-[#111C2A] border border-amber-500/20 rounded-3xl p-8 shadow-xl relative overflow-hidden">
          <div class="absolute right-[-20px] top-[-20px] w-48 h-48 text-amber-500/5 rotate-12 pointer-events-none" style="mask-image: linear-gradient(to bottom, black, transparent);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>

          <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/10 relative z-10">
            <div>
              <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Gestión de Denuncias Pendientes
              </h2>
              <p class="text-xs text-slate-400 mt-1">Revisa y actúa sobre el comportamiento de los usuarios reportados.</p>
            </div>
            <div class="text-[10px] font-black bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg text-slate-500 uppercase tracking-widest">
              Limpieza automática tras 1 mes (completadas)
            </div>
          </div>

          <div id="list-reports" class="space-y-4 relative z-10">
            {reports?.map((report) => (
              <div class="bg-[#0b1016] border border-white/5 rounded-2xl overflow-hidden group hover:border-amber-500/20 transition-all shadow-lg" id={`report-card-${report.id}`}>
                <div class="p-5 flex flex-col md:flex-row gap-6">
                  <!-- Columna Denunciante/Denunciado -->
                  <div class="md:w-48 shrink-0 flex flex-col gap-4">
                    <div class="space-y-1">
                      <span class="text-[9px] font-black text-slate-500 uppercase tracking-widest">Denunciante</span>
                      <div class="flex items-center gap-2 p-2 bg-white/5 rounded-lg">
                        <img src={report.reporter_avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(report.reporter_name)}&background=111C2A&color=94a3b8`} class="w-6 h-6 rounded-full" alt=""/>
                        <span class="text-xs font-bold text-slate-300 truncate">{report.reporter_name}</span>
                      </div>
                    </div>
                    <div class="space-y-1">
                      <span class="text-[9px] font-black text-amber-500 uppercase tracking-widest">Denunciado</span>
                      <div class="flex items-center gap-2 p-2 bg-amber-500/10 border border-amber-500/20 rounded-lg">
                        <img src={report.reported_avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(report.reported_name)}&background=111C2A&color=f59e0b`} class="w-6 h-6 rounded-full" alt=""/>
                        <span class="text-xs font-black text-white truncate">{report.reported_name}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Columna Detalle -->
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="px-2 py-0.5 bg-slate-800 text-slate-400 text-[9px] font-bold rounded uppercase tracking-tighter">Asunto</span>
                      <h3 class="font-bold text-white text-sm">{report.title}</h3>
                    </div>
                    <p class="text-sm text-slate-400 bg-black/20 p-3 rounded-xl border border-white/5 mb-4 leading-relaxed italic">
                      "{report.description}"
                    </p>
                    {report.thread_title && (
                      <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        Contexto: <a href={`/comunidad/hilo/${report.thread_id}`} target="_blank" class="text-[#00A3FF] hover:underline font-bold">Ver Hilo / Publicación</a>
                      </div>
                    )}
                  </div>

                  <!-- Columna Acciones -->
                  <div class="flex flex-col justify-center items-end gap-2 md:w-32">
                    <button class="btn-verdict w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-black font-black text-xs rounded-xl transition-all shadow-lg hover:shadow-amber-500/20" 
                            data-report-id={report.id} 
                            data-reported-id={report.reported_user_id} 
                            data-reported-name={report.reported_name}>
                      VEREDICTO
                    </button>
                    <button class="btn-dismiss-report w-full py-2.5 bg-white/5 hover:bg-white/10 text-slate-400 text-xs font-bold rounded-xl transition-all" data-id={report.id}>
                      IGNORAR
                    </button>
                  </div>
                </div>
              </div>
            ))}
            {(!reports || reports.length === 0) && (
              <div class="py-12 flex flex-col items-center justify-center bg-black/20 rounded-3xl border border-dashed border-white/10">
                <svg class="w-12 h-12 text-slate-700 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <p class="text-slate-500 font-bold uppercase tracking-widest text-xs">No hay denuncias pendientes</p>
              </div>
            )}
          </div>
        </section>
      </div>
    </div>

    <!-- Modal Formulario Categoría -->
    <dialog id="modal-category" class="bg-[#0b1016] text-white border border-white/10 rounded-2xl p-8 shadow-2xl backdrop-blur-xl w-[90%] max-w-[500px] m-auto">
      <h2 id="modal-category-title" class="text-2xl font-bold mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        <span>Crear Categoría</span>
      </h2>
      <form id="form-category" class="space-y-4">
        <input type="hidden" id="cat-id" value="">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Nombre de la Categoría *</label>
          <input type="text" id="cat-name" required class="w-full bg-[#111C2A] border border-slate-700 text-white p-3 rounded-lg focus:outline-none focus:border-[#00A3FF] transition-colors" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Descripción</label>
          <textarea id="cat-desc" rows="3" class="w-full bg-[#111C2A] border border-slate-700 text-white p-3 rounded-lg focus:outline-none focus:border-[#00A3FF] transition-colors resize-none"></textarea>
        </div>
        <div id="cat-error" class="hidden text-sm font-bold text-rose-500 bg-rose-500/10 p-3 rounded flex items-center gap-2">
           <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
           <span id="cat-error-text">Error</span>
        </div>
        <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-white/5">
          <button type="button" id="btn-cancel-cat" class="px-5 py-2.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors">Cancelar</button>
          <button type="submit" id="btn-save-cat" class="px-6 py-2.5 bg-[#00A3FF] text-black font-bold rounded-lg hover:bg-[#00E5FF] transition-colors">Guardar</button>
        </div>
      </form>
    </dialog>

    <!-- Modal Veredicto -->
    <dialog id="modal-verdict" class="bg-[#0b1016] text-white border border-white/10 rounded-3xl p-8 shadow-2xl backdrop-blur-xl w-[95%] max-w-[500px] m-auto">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-12 h-12 bg-rose-500/20 text-rose-500 rounded-2xl flex items-center justify-center">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div>
          <h2 class="text-xl font-black uppercase tracking-tight">Emitir Veredicto</h2>
          <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1 italic">Sanción para <span id="verdict-user-name" class="text-rose-500 font-extrabold"></span></p>
        </div>
      </div>

      <form id="form-verdict" class="space-y-6">
        <input type="hidden" id="verdict-reported-id">
        <input type="hidden" id="verdict-report-id">
        
        <div class="space-y-3">
          <label class="block text-[10px] font-black uppercase text-slate-500 tracking-[0.2em]">Tipo de Sanción *</label>
          <div class="grid grid-cols-1 gap-2">
            <label class="relative flex items-center p-4 bg-[#111C2A] border border-white/5 rounded-xl cursor-pointer hover:border-white/10 transition-colors group">
              <input type="radio" name="verdict-type" value="advertencia" required class="w-4 h-4 text-amber-500 focus:ring-amber-500 bg-[#0b1016] border-white/10" checked>
              <div class="ml-3">
                <span class="block text-sm font-bold text-white uppercase tracking-tight">Advertencia</span>
                <span class="block text-[10px] text-slate-500">Aumenta el contador de infracciones.</span>
              </div>
            </label>
            <label class="relative flex items-center p-4 bg-[#111C2A] border border-white/5 rounded-xl cursor-pointer hover:border-white/10 transition-colors group">
              <input type="radio" name="verdict-type" value="suspension" class="w-4 h-4 text-orange-500 focus:ring-orange-500 bg-[#0b1016] border-white/10">
              <div class="ml-3">
                <span class="block text-sm font-bold text-white uppercase tracking-tight">Suspensión Temporal (7 días)</span>
                <span class="block text-[10px] text-slate-500">Bloquea el acceso por una semana.</span>
              </div>
            </label>
            <label class="relative flex items-center p-4 bg-[#111C2A] border border-white/5 rounded-xl cursor-pointer hover:border-white/10 transition-colors group">
              <input type="radio" name="verdict-type" value="expulsion" class="w-4 h-4 text-rose-500 focus:ring-rose-500 bg-[#0b1016] border-white/10">
              <div class="ml-3">
                <span class="block text-sm font-bold text-white uppercase tracking-tight">Expulsión Definitiva (Ban)</span>
                <span class="block text-[10px] text-slate-500 text-rose-400 font-bold uppercase">Acción irreversible e inmediata.</span>
              </div>
            </label>
            <label class="relative flex items-center p-4 bg-[#111C2A] border border-white/5 rounded-xl cursor-pointer hover:border-white/10 transition-colors group">
              <input type="radio" name="verdict-type" value="dismissed" class="w-4 h-4 text-slate-500 focus:ring-slate-500 bg-[#0b1016] border-white/10">
              <div class="ml-3">
                <span class="block text-sm font-bold text-white uppercase tracking-tight">Desestimar Denuncia</span>
                <span class="block text-[10px] text-slate-500">Cierra la denuncia sin sanción.</span>
              </div>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-black uppercase text-slate-500 tracking-[0.2em] mb-2">Motivo del Veredicto (Interno)</label>
          <textarea id="verdict-reason" rows="3" required placeholder="Describe brevemente por qué se toma esta decisión..." class="w-full bg-[#111C2A] border border-white/10 text-white p-4 rounded-xl focus:outline-none focus:border-rose-500 transition-colors resize-none shadow-inner"></textarea>
        </div>

        <div id="verdict-error" class="hidden p-3 bg-rose-500/10 border border-rose-500/20 text-rose-500 text-xs font-bold rounded-xl animate-shake"></div>

        <p class="text-[9px] text-slate-500 leading-relaxed">
          * Al confirmar, se cerrarán <strong>todas</strong> las denuncias pendientes sobre este usuario por haber sido ya procesadas.
        </p>

        <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-white/5">
          <button type="button" id="btn-cancel-verdict" class="px-5 py-2.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors uppercase tracking-widest text-[10px]">Cancelar</button>
          <button type="submit" id="btn-confirm-verdict" class="px-6 py-2.5 bg-rose-500 text-white font-black rounded-xl hover:bg-rose-400 transition-colors uppercase tracking-widest text-[10px] shadow-lg shadow-rose-500/20">Confirmar Veredicto</button>
        </div>
      </form>
    </dialog>
    
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const authLoading = document.getElementById('auth-loading');
  const protectedContent = document.getElementById('protected-content');
  const sectionCategories = document.getElementById('section-categories');
  const badgeRole = document.getElementById('badge-role');

  // Lógica de validación
  async function checkAccess() {
    const { data: { session } } = await supabase.auth.getSession();
    
    if (!session) {
      alert("Acceso denegado. Debes iniciar sesión.");
      window.location.href = '/login?redirect=/comunidad/configuracion';
      return;
    }

    // Obtener rol
    const { data: perfilData } = await supabase
      .from('perfiles')
      .select('rol')
      .eq('id', session.user.id)
      .maybeSingle();
      
    const rol = perfilData?.rol || 'usuario';

    if (rol !== 'admin' && rol !== 'instructor') {
      alert("Acceso denegado. No tienes permisos para ver esta página.");
      window.location.href = '/comunidad';
      return;
    }

    // Configurar UI según rol
    if (authLoading) authLoading.style.display = 'none';
    if (protectedContent) protectedContent.classList.remove('hidden');

    if (badgeRole) {
      if (rol === 'admin') {
        badgeRole.textContent = 'ADMINISTRADOR';
        badgeRole.classList.add('bg-rose-500/20', 'text-rose-400');
        if (sectionCategories) sectionCategories.classList.remove('hidden');
      } else {
        badgeRole.textContent = 'COACH / TRAINER';
        badgeRole.classList.add('bg-emerald-500/20', 'text-emerald-400');
        // Instructores no ven gestión de categorías, queda oculto.
      }
    }
  }

  // ===== GESTIÓN DE CATEGORÍAS =====
  const modalCategory = document.getElementById('modal-category') as HTMLDialogElement;
  const formCategory = document.getElementById('form-category') as HTMLFormElement;
  const btnNewCat = document.getElementById('btn-new-category');
  const btnCancelCat = document.getElementById('btn-cancel-cat');
  const catErrorBox = document.getElementById('cat-error');
  const catErrorText = document.getElementById('cat-error-text');
  const btnSaveCat = document.getElementById('btn-save-cat') as HTMLButtonElement;
  const modalCatTitle = document.getElementById('modal-category-title');
  const catIdInput = document.getElementById('cat-id') as HTMLInputElement;
  const catNameInput = document.getElementById('cat-name') as HTMLInputElement;
  const catDescInput = document.getElementById('cat-desc') as HTMLTextAreaElement;

  btnNewCat?.addEventListener('click', () => {
    formCategory.reset();
    catIdInput.value = '';
    if (modalCatTitle) modalCatTitle.innerHTML = '<svg class="w-6 h-6 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg> <span>Crear Categoría</span>';
    if (catErrorBox) catErrorBox.classList.add('hidden');
    modalCategory?.showModal();
  });

  btnCancelCat?.addEventListener('click', () => {
    modalCategory?.close();
  });

  const gridCategories = document.getElementById('grid-categories');
  if (gridCategories) {
    gridCategories.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      
      // Botón Editar
      const btnEdit = target.closest('.btn-edit-cat') as HTMLButtonElement;
      if (btnEdit) {
        catIdInput.value = btnEdit.dataset.id || '';
        catNameInput.value = btnEdit.dataset.name || '';
        catDescInput.value = btnEdit.dataset.desc || '';
        if (modalCatTitle) modalCatTitle.innerHTML = '<svg class="w-6 h-6 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> <span>Editar Categoría</span>';
        if (catErrorBox) catErrorBox.classList.add('hidden');
        modalCategory?.showModal();
        return;
      }

      // Botón Eliminar
      const btnDelete = target.closest('.btn-delete-cat') as HTMLButtonElement;
      if (btnDelete) {
        const id = btnDelete.dataset.id;
        const name = btnDelete.dataset.name;
        
        if (confirm(`¿Estás seguro de eliminar la categoría "${name}"? Se borrarán todos sus hilos y respuestas.`)) {
          try {
            const { error } = await supabase.from('forum_categories').delete().eq('id', id);
            if (error) throw error;
          } catch (err: any) {
            alert('Error eliminando: ' + err.message);
          }
        }
      }
    });
  }

  formCategory?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (catErrorBox) catErrorBox.classList.add('hidden');
    btnSaveCat.disabled = true;
    btnSaveCat.textContent = 'Guardando...';

    const id = catIdInput.value;
    const name = catNameInput.value.trim();
    const description = catDescInput.value.trim();

    try {
      if (id) {
        // Update
        const { error } = await supabase
          .from('forum_categories')
          .update({ name, description })
          .eq('id', id);
        if (error) throw error;
      } else {
        // Insert
        const { error } = await supabase
          .from('forum_categories')
          .insert({ name, description });
        if (error) throw error;
      }
      modalCategory.close();
      btnSaveCat.disabled = false;
      btnSaveCat.textContent = 'Guardar';
    } catch (err: any) {
      if (catErrorBox && catErrorText) {
        catErrorBox.classList.remove('hidden');
        catErrorText.textContent = err.message;
      }
      btnSaveCat.disabled = false;
      btnSaveCat.textContent = 'Guardar';
    }
  });

  // --- Realtime Categories Subscription ---
  supabase
    .channel('config_forum_categories')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'forum_categories' }, async () => {
      const { data: newCats } = await supabase.from('forum_categories').select('*').order('created_at', { ascending: true });
      if (!newCats) return;

      if (gridCategories) {
        if (newCats.length === 0) {
          gridCategories.innerHTML = '<p class="text-sm text-slate-500 col-span-full">No hay categorías configuradas.</p>';
        } else {
          gridCategories.innerHTML = newCats.map(cat => `
            <div class="bg-[#0b1016] border border-white/5 p-4 rounded-xl flex flex-col justify-between group hover:border-[#00A3FF]/30 transition-colors">
              <div>
                <h3 class="font-bold text-white mb-1 group-hover:text-[#00A3FF] transition-colors">\${cat.name}</h3>
                <p class="text-xs text-slate-500 line-clamp-2">\${cat.description || 'Sin descripción'}</p>
              </div>
              <div class="flex items-center gap-2 mt-4 pt-3 border-t border-white/5">
                <button class="btn-edit-cat flex-1 py-1.5 px-3 bg-white/5 hover:bg-white/10 text-white text-xs font-bold rounded flex items-center justify-center gap-1 transition-colors" data-id="\${cat.id}" data-name="\${cat.name}" data-desc="\${cat.description || ''}">
                  Editar
                </button>
                <button class="btn-delete-cat px-3 py-1.5 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 rounded text-xs transition-colors" data-id="\${cat.id}" data-name="\${cat.name}">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                </button>
              </div>
            </div>
          `).join('');
        }
      }
    })
    .subscribe();

  // ===== GESTIÓN DE HILOS =====
  document.querySelectorAll('.btn-delete-thread').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLElement;
      // ascender hasta el botón si capturamos el SVG
      const button = target.closest('button');
      if (!button) return;

      const id = button.dataset.id;
      const title = button.dataset.title;
      
      if (confirm(`¿Seguro que deseas eliminar el hilo:\n"${title}"?\n\nEsta acción es irreversible.`)) {
        try {
          const { error } = await supabase.from('forum_threads').delete().eq('id', id);
          if (error) throw error;
          
          const row = document.getElementById(`thread-row-${id}`);
          if (row) row.remove();
        } catch (err: any) {
          alert('Error eliminando hilo: ' + err.message);
        }
      }
    });
  });

  // ===== GESTIÓN DE DENUNCIAS =====
  const modalVerdict = document.getElementById('modal-verdict') as HTMLDialogElement;
  const formVerdict = document.getElementById('form-verdict') as HTMLFormElement;
  const verdictUserName = document.getElementById('verdict-user-name');
  const verdictReportedIdInput = document.getElementById('verdict-reported-id') as HTMLInputElement;
  const verdictReportIdInput = document.getElementById('verdict-report-id') as HTMLInputElement;
  const verdictErrorBox = document.getElementById('verdict-error');
  const btnCancelVerdict = document.getElementById('btn-cancel-verdict');
  const btnConfirmVerdict = document.getElementById('btn-confirm-verdict') as HTMLButtonElement;

  const listReports = document.getElementById('list-reports');

  if (listReports) {
    listReports.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      
      // Botón Veredicto
      const btnVerdict = target.closest('.btn-verdict') as HTMLButtonElement;
      if (btnVerdict) {
        const reportId = btnVerdict.dataset.reportId;
        const reportedId = btnVerdict.dataset.reportedId;
        const reportedName = btnVerdict.dataset.reportedName;

        if (verdictReportIdInput) verdictReportIdInput.value = reportId || '';
        if (verdictReportedIdInput) verdictReportedIdInput.value = reportedId || '';
        if (verdictUserName) verdictUserName.textContent = reportedName || '';
        if (verdictErrorBox) verdictErrorBox.classList.add('hidden');
        
        modalVerdict?.showModal();
        return;
      }

      // Botón Ignorar (Solo marca esta denuncia como completada)
      const btnDismiss = target.closest('.btn-dismiss-report') as HTMLButtonElement;
      if (btnDismiss) {
        const id = btnDismiss.dataset.id;
        if (confirm('¿Ignorar esta denuncia? No se aplicará ninguna sanción.')) {
          try {
            const { error } = await supabase
              .from('forum_reports')
              .update({ status: 'completed', completed_at: new Date().toISOString() })
              .eq('id', id);
            if (error) throw error;
            
            const card = document.getElementById(`report-card-${id}`);
            if (card) card.remove();
          } catch (err: any) {
            alert('Error: ' + err.message);
          }
        }
      }
    });
  }

  btnCancelVerdict?.addEventListener('click', () => modalVerdict?.close());

  formVerdict?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (verdictErrorBox) verdictErrorBox.classList.add('hidden');
    
    btnConfirmVerdict.disabled = true;
    btnConfirmVerdict.textContent = 'Procesando...';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const reportId = verdictReportIdInput.value;
    const reportedId = verdictReportedIdInput.value;
    const verdictType = (formVerdict.querySelector('input[name="verdict-type"]:checked') as HTMLInputElement).value;
    const reason = (document.getElementById('verdict-reason') as HTMLTextAreaElement).value;

    try {
      // 1. Si hay sanción, registrarla en user_infractions
      if (verdictType !== 'dismissed') {
        const { error: infractionError } = await supabase
          .from('user_infractions')
          .insert({
            user_id: reportedId,
            admin_id: session.user.id,
            type: verdictType,
            reason: reason
          });
        if (infractionError) throw infractionError;

        // 2. Actualizar perfil
        let profileUpdate: any = {};
        if (verdictType === 'advertencia') {
          // Necesitamos el conteo actual o usar rpc, pero para simplicidad traemos el perfil
          const { data: p } = await supabase.from('perfiles').select('infraction_count').eq('id', reportedId).single();
          profileUpdate.infraction_count = (p?.infraction_count || 0) + 1;
        } else if (verdictType === 'suspension') {
          profileUpdate.status = 'suspended';
          const until = new Date();
          until.setDate(until.getDate() + 7);
          profileUpdate.suspended_until = until.toISOString();
        } else if (verdictType === 'expulsion') {
          profileUpdate.status = 'banned';
        }

        if (Object.keys(profileUpdate).length > 0) {
          const { error: profileError } = await supabase
            .from('perfiles')
            .update(profileUpdate)
            .eq('id', reportedId);
          if (profileError) throw profileError;
        }
      }

      // 3. Marcar TODAS las denuncias pendientes de ESE usuario como completadas
      const { error: reportsError } = await supabase
        .from('forum_reports')
        .update({ status: 'completed', completed_at: new Date().toISOString() })
        .eq('reported_user_id', reportedId)
        .eq('status', 'pending');
        
      if (reportsError) throw reportsError;

      alert('Veredicto aplicado correctamente.');
      modalVerdict.close();
      formVerdict.reset();
      
      // La UI se actualizará vía Realtime o recarga
      window.location.reload(); 
    } catch (err: any) {
      if (verdictErrorBox) {
        verdictErrorBox.textContent = err.message;
        verdictErrorBox.classList.remove('hidden');
      }
    } finally {
      btnConfirmVerdict.disabled = false;
      btnConfirmVerdict.textContent = 'Confirmar Veredicto';
    }
  });

  // Realtime para denuncias
  supabase
    .channel('config_forum_reports')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'forum_reports' }, async () => {
      // Recargar denuncias o simplemente recargar la página para simplicidad en este panel complejo
      // En una SPA real haríamos un fetch y update del DOM
    })
    .subscribe();

  // Ejecutar al cargar la página
  checkAccess();
</script>
