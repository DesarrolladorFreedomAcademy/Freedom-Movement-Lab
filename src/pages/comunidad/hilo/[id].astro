---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import ReplyBox from '../../../components/ReplyBox.astro';
import { supabase } from '../../../lib/supabase';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/comunidad');
}

// Obtener el hilo
const { data: thread, error: threadError } = await supabase
  .from('vw_forum_threads')
  .select('*')
  .eq('id', id)
  .single();

if (threadError || !thread) {
  return Astro.redirect('/comunidad');
}

// Obtener categoría del hilo
const { data: cat } = await supabase
  .from('forum_categories')
  .select('name')
  .eq('id', thread.category_id)
  .single();

const isQuedada = cat?.name?.toLowerCase() === 'quedadas';

// Obtener los posts
const { data: posts, error: postsError } = await supabase
  .from('vw_forum_posts')
  .select('*')
  .eq('thread_id', id)
  .order('created_at', { ascending: true });

// Obtener sesión del usuario actual (servidor)
const { data: { session } } = await supabase.auth.getSession();
const currentUserId = session?.user?.id;

// Obtener rol del usuario actual
let currentUserRole = 'usuario';
if (currentUserId) {
  const { data: profile } = await supabase
    .from('perfiles')
    .select('rol')
    .eq('id', currentUserId)
    .maybeSingle(); // Usar maybeSingle por si el perfil aún no se sincronizó
  if (profile) currentUserRole = profile.rol;
}

const canDeleteThread = currentUserId === thread.user_id || currentUserRole === 'admin' || currentUserRole === 'instructor';
const isStaff = (role: string) => role === 'admin' || role === 'instructor';
const getRoleLabel = (role: string) => role === 'admin' ? 'ADMIN' : 'TRAINER';
const getRoleColor = (role: string) => role === 'admin' ? 'bg-rose-500/20 text-rose-400 border-rose-500/30' : 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30';

function formatTime(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function renderPostContent(content: string) {
  // Regex que busca o bien un tag <a> con URL de YouTube, o bien una URL de YouTube suelta (incluyendo parámetros extra)
  const youtubeRegex = /<a [^>]*href=["'](?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})[^"']*["'][^>]*>.*?<\/a>|(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})[^\s<]*/g;
  
  return content.replace(youtubeRegex, (match, G1, G2) => {
    const videoId = G1 || G2;
    return `
      <div class="my-8 aspect-video w-full max-w-3xl overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-black mx-auto">
        <iframe 
          class="w-full h-full"
          src="https://www.youtube.com/embed/${videoId}" 
          title="YouTube video player" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen>
        </iframe>
      </div>
    `;
  });
}
---

<Layout title={thread.title}>
  {isQuedada && (
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  )}
  <Nav />
  
  <main class="max-w-5xl mx-auto px-4 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-500 mb-6">
      <a href="/comunidad" class="hover:text-[#00A3FF] transition-colors">Comunidad</a>
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="text-slate-400">Hilo</span>
    </nav>

    <!-- Thread Header -->
    <header class="mb-10">
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-4 tracking-tight">
        {thread.title}
      </h1>
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-[#00A3FF]/30 bg-[#111C2A] flex-shrink-0">
            <img 
              src={thread.author_avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(thread.author_name)}&background=111C2A&color=00A3FF`} 
              alt="" 
              class="w-full h-full object-cover" 
              onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(thread.author_name)}&background=111C2A&color=00A3FF';`}
            />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-0.5">
              <p class="text-sm font-bold text-white leading-none">{thread.author_name}</p>
              {isStaff(thread.author_role) && (
                <span class={`text-[8px] font-black px-1.5 py-0.5 rounded border ${getRoleColor(thread.author_role)} tracking-widest`}>
                  {getRoleLabel(thread.author_role)}
                </span>
              )}
            </div>
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Iniciado el {formatTime(thread.created_at)}</p>
          </div>
        </div>
        
        <button id="btn-delete-thread" class="hidden p-2 text-slate-500 hover:text-rose-500 hover:bg-rose-500/10 rounded-lg transition-all" title="Eliminar Hilo" data-author-id={thread.user_id}>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        </button>
      </div>
    </header>

    <!-- Posts List -->
    <div class="space-y-8 mb-12">
      {posts && posts.map((post, index) => (
        <article class={`group relative flex flex-col md:flex-row gap-4 md:gap-8 p-6 rounded-2xl border border-white/5 transition-all duration-300 ${index === 0 ? 'bg-white/[0.03] border-white/10' : 'bg-transparent hover:bg-white/[0.02]'}`}>
          
          <!-- Author Info Side -->
          <aside class="flex md:flex-col items-center md:items-start gap-3 md:w-40 shrink-0">
            <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl overflow-hidden border-2 border-white/10 group-hover:border-[#008AE6]/50 transition-colors shadow-lg bg-[#111C2A] flex-shrink-0">
              <img 
                src={post.author_avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(post.author_name)}&background=111C2A&color=00A3FF`} 
                alt="" 
                class="w-full h-full object-cover" 
                onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(post.author_name)}&background=111C2A&color=00A3FF';`}
              />
            </div>
            <div class="md:mt-2 text-center md:text-left w-full">
              <div class="flex flex-col md:items-start gap-1">
                <p class={`text-sm font-black transition-colors truncate max-w-[120px] md:max-w-none ${isStaff(post.author_role) ? 'text-white' : 'text-slate-200 group-hover:text-[#00A3FF]'}`}>
                  {post.author_name}
                </p>
                {isStaff(post.author_role) && (
                  <span class={`text-[8px] font-black px-1.5 py-0.5 rounded border ${getRoleColor(post.author_role)} tracking-widest w-fit`}>
                    {getRoleLabel(post.author_role)}
                  </span>
                )}
              </div>
              <p class="text-[9px] font-black text-slate-500 uppercase tracking-tighter opacity-70 mt-1">
                {formatTime(post.created_at)}
              </p>
            </div>
          </aside>

          <!-- Content Side -->
          <div class="flex-1 min-w-0">
            <div class="forum-content max-w-none">
              <div set:html={renderPostContent(post.content)} />
            </div>

            {post.location_lat && post.location_lng && (
              <div class="mt-4 p-4 bg-[#0F172A] border border-white/5 rounded-xl max-w-2xl">
                <div class="flex items-center gap-2 mb-3">
                  <svg class="w-5 h-5 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  <h4 class="text-sm font-bold text-white uppercase tracking-widest">Ubicación de la Quedada</h4>
                </div>
                {post.location_address && !post.location_address.includes('toFixed') && (
                  <p class="text-xs text-slate-400 mb-3">{post.location_address}</p>
                )}
                <div class="static-map-container w-full aspect-[4/3] rounded-lg overflow-hidden bg-[#111C2A] border border-white/10 mb-3" data-lat={post.location_lat} data-lng={post.location_lng}></div>
                <div class="flex">
                  <a href={`https://www.google.com/maps/dir/?api=1&destination=${post.location_lat},${post.location_lng}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-[#00A3FF]/10 text-[#00A3FF] hover:bg-[#00A3FF] hover:text-black font-bold text-xs rounded-lg transition-colors border border-[#00A3FF]/20">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    Obtener Indicaciones
                  </a>
                </div>
              </div>
            )}
            
            {/* Acciones del Post */}
            <div class="flex justify-end gap-2 mt-4">
              <button class="btn-report-post p-1.5 text-slate-600 hover:text-amber-500 hover:bg-amber-500/10 rounded transition-all" data-post-id={post.id} data-author-id={post.user_id} data-author-name={post.author_name} title="Denunciar Respuesta">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v8"/><path d="M12 14v.01"/><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
              </button>
              <button class="btn-edit-post hidden p-1.5 text-slate-600 hover:text-[#00A3FF] hover:bg-[#00A3FF]/10 rounded transition-all" data-post-id={post.id} data-author-id={post.user_id} title="Editar Respuesta">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <template id={`raw-content-${post.id}`}>{post.content}</template>
              </button>
              <button class="btn-delete-post hidden p-1.5 text-slate-600 hover:text-rose-500 hover:bg-rose-500/10 rounded transition-all" data-post-id={post.id} data-author-id={post.user_id} title="Eliminar Respuesta">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Reply Section -->
    <section id="responder" class="pt-8 border-t border-white/10">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-2 h-8 bg-[#00A3FF] rounded-full shadow-[0_0_15px_rgba(0,163,255,0.5)]"></div>
        <h2 class="text-2xl font-black text-white uppercase tracking-tight">Tu respuesta</h2>
      </div>
      
      <ReplyBox threadId={thread.id} isQuedada={isQuedada} />
    </section>

    <!-- Edit Post Modal -->
    <dialog id="edit-post-modal" class="bg-[#0b1016] text-white border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl backdrop-blur-xl w-[95%] max-w-[800px] m-auto z-50">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold flex items-center gap-2">
          <svg class="w-6 h-6 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Editar Respuesta
        </h2>
        <button id="btn-close-edit-modal" class="text-slate-500 hover:text-white transition-colors">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="w-full flex flex-col gap-3 group relative">
        <div class="flex items-center flex-wrap gap-1 p-2 bg-[#182538] border border-white/10 rounded-t-xl border-b-0">
          <button type="button" id="edit-btn-bold" class="editor-btn p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded transition-colors"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 12a4 4 0 0 0 0-8H6v8"/><path d="M15 20a4 4 0 0 0 0-8H6v8Z"/></svg></button>
          <button type="button" id="edit-btn-italic" class="editor-btn p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded transition-colors"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg></button>
          <div class="w-px h-5 bg-white/10 mx-1"></div>
          <button type="button" id="edit-btn-bullet" class="editor-btn p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded transition-colors"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></button>
          <button type="button" id="edit-btn-ordered" class="editor-btn p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded transition-colors"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg></button>
          <div class="w-px h-5 bg-white/10 mx-1"></div>
          <button type="button" id="edit-btn-link" class="editor-btn p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded transition-colors"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>
        </div>
        
        <div id="edit-tiptap-editor" class="bg-[#111C2A] text-white border border-white/10 rounded-b-xl focus-within:border-[#008AE6] transition-colors p-4 min-h-[150px] max-h-[400px] overflow-y-auto"></div>

        <div id="edit-error" class="hidden text-sm font-bold text-rose-500 mt-2 bg-rose-500/10 p-2.5 rounded border border-rose-500/20"></div>

        <div class="flex justify-end gap-3 mt-4">
          <button id="btn-cancel-edit" class="px-5 py-2.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors">Cancelar</button>
          <button id="btn-save-edit" class="btn-primary px-8 py-2.5 bg-[#00A3FF] hover:bg-[#00E5FF] text-black font-extrabold rounded-lg transition-all shadow-[0_0_15px_rgba(0,163,255,0.4)]">Guardar Cambios</button>
        </div>
      </div>
    </dialog>
    
    <!-- Report Post Modal -->
    <dialog id="report-modal" class="bg-[#111C2A] text-white border border-white/10 rounded-3xl p-8 shadow-2xl backdrop-blur-xl w-[90%] max-w-[500px] m-auto">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-12 h-12 bg-amber-500/20 text-amber-500 rounded-2xl flex items-center justify-center">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div>
          <h2 class="text-xl font-black uppercase tracking-tight">Denunciar Contenido</h2>
          <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1">Usuario: <span id="report-user-name" class="text-white"></span></p>
        </div>
      </div>

      <form id="report-form" class="space-y-5">
        <input type="hidden" id="report-post-id">
        <input type="hidden" id="report-reported-user-id">
        
        <div>
          <label class="block text-[10px] font-black uppercase text-slate-500 tracking-[0.2em] mb-2">Asunto de la denuncia</label>
          <input type="text" id="report-title" required placeholder="Ej: Contenido inapropiado, Spam..." class="w-full bg-[#0b1016] border border-white/10 text-white p-4 rounded-xl focus:outline-none focus:border-amber-500 transition-colors shadow-inner" />
        </div>

        <div>
          <label class="block text-[10px] font-black uppercase text-slate-500 tracking-[0.2em] mb-2">Explica el motivo (mín. 10 caracteres)</label>
          <textarea id="report-description" rows="4" required minlength="10" placeholder="Describe brevemente qué norma se está incumpliendo..." class="w-full bg-[#0b1016] border border-white/10 text-white p-4 rounded-xl focus:outline-none focus:border-amber-500 transition-colors resize-none shadow-inner"></textarea>
        </div>

        <div id="report-error" class="hidden p-3 bg-rose-500/10 border border-rose-500/20 text-rose-500 text-xs font-bold rounded-xl animate-shake"></div>

        <div class="flex items-center justify-end gap-4 pt-4 border-t border-white/5">
          <button type="button" id="btn-cancel-report" class="text-sm font-bold text-slate-500 hover:text-white transition-colors uppercase tracking-widest">Cancelar</button>
          <button type="submit" id="btn-submit-report" class="px-8 py-3 bg-amber-500 hover:bg-amber-400 text-black font-black rounded-xl transition-all shadow-lg hover:shadow-amber-500/20 uppercase tracking-widest text-xs">Enviar Denuncia</button>
        </div>
      </form>
    </dialog>

  </main>
</Layout>

<script>
  import { supabase } from '../../../lib/supabase';

  // --- Auth & Permission Check ---
  async function checkPermissions() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const currentUserId = session.user.id;
    const { data: profile } = await supabase.from('perfiles').select('rol').eq('id', currentUserId).maybeSingle();
    const currentUserRole = profile?.rol || 'usuario';

    // Hilo
    const btnDeleteThread = document.getElementById('btn-delete-thread');
    if (btnDeleteThread) {
      const authorId = (btnDeleteThread as HTMLElement).dataset.authorId;
      if (currentUserId === authorId || currentUserRole === 'admin' || currentUserRole === 'instructor') {
        btnDeleteThread.classList.remove('hidden');
      }
    }

    // Posts (Delete)
    const deletePostBtns = document.querySelectorAll('.btn-delete-post');
    deletePostBtns.forEach(btn => {
      const authorId = (btn as HTMLElement).dataset.authorId;
      if (currentUserId === authorId || currentUserRole === 'admin' || currentUserRole === 'instructor') {
        btn.classList.remove('hidden');
      }
    });

    // Posts (Edit)
    const editPostBtns = document.querySelectorAll('.btn-edit-post');
    editPostBtns.forEach(btn => {
      const authorId = (btn as HTMLElement).dataset.authorId;
      if (currentUserId === authorId) {
        btn.classList.remove('hidden');
      }
    });

    // Guardar ID en body para Realtime
    document.body.dataset.userId = currentUserId;
    document.body.dataset.userRole = currentUserRole;
  }

  checkPermissions();

  // --- Deletion Logic ---

  // Delete Thread
  const btnDeleteThread = document.getElementById('btn-delete-thread');
  if (btnDeleteThread) {
    btnDeleteThread.addEventListener('click', async () => {
      if (!confirm('¿Estás seguro de que quieres eliminar este hilo y todas sus respuestas? Esta acción no se puede deshacer.')) return;
      
      const threadId = btnDeleteThread.closest('main')?.querySelector('nav span')?.parentElement?.dataset.id || window.location.pathname.split('/').pop();
      
      try {
        const { error } = await supabase
          .from('forum_threads')
          .delete()
          .eq('id', threadId);

        if (error) throw error;
        window.location.href = '/comunidad';
      } catch (err: any) {
        alert('Error al eliminar el hilo: ' + err.message);
      }
    });
  }

  // Delete Individual Post
  const deletePostBtns = document.querySelectorAll('.btn-delete-post');
  deletePostBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
      const postId = (btn as HTMLElement).dataset.postId;
      if (!postId) return;

      if (!confirm('¿Estás seguro de que quieres eliminar esta respuesta?')) return;

      try {
        const { error } = await supabase
          .from('forum_posts')
          .delete()
          .eq('id', postId);

        if (error) throw error;
        
        // Animación de salida y recarga
        const article = btn.closest('article');
        if (article) {
          article.classList.add('opacity-0', 'scale-95');
          setTimeout(() => window.location.reload(), 300);
        } else {
          window.location.reload();
        }
      } catch (err: any) {
        alert('Error al eliminar la respuesta: ' + err.message);
      }
    });
  });
  // Edit Individual Post Logic
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  
  let editEditor: any = null;
  let currentEditingPostId = '';
  const editModal = document.getElementById('edit-post-modal') as HTMLDialogElement;

  function initEditEditor() {
    const editEditorEl = document.getElementById('edit-tiptap-editor');
    if (editEditor || !editEditorEl) return;

    editEditor = new Editor({
      element: editEditorEl,
      extensions: [
        StarterKit.configure({
          history: true,
          bold: { HTMLAttributes: { class: 'font-bold text-white' } },
          italic: { HTMLAttributes: { class: 'italic text-slate-200' } },
        })
      ],
      content: '', // set dynamically
      onTransaction: () => {
        document.getElementById('edit-btn-bold')?.classList.toggle('text-[#00A3FF]', editEditor.isActive('bold'));
        document.getElementById('edit-btn-italic')?.classList.toggle('text-[#00A3FF]', editEditor.isActive('italic'));
        document.getElementById('edit-btn-bullet')?.classList.toggle('text-[#00A3FF]', editEditor.isActive('bulletList'));
        document.getElementById('edit-btn-ordered')?.classList.toggle('text-[#00A3FF]', editEditor.isActive('orderedList'));
        document.getElementById('edit-btn-link')?.classList.toggle('text-[#00A3FF]', editEditor.isActive('link'));
      }
    });

    document.getElementById('edit-btn-bold')?.addEventListener('click', () => editEditor.chain().focus().toggleBold().run());
    document.getElementById('edit-btn-italic')?.addEventListener('click', () => editEditor.chain().focus().toggleItalic().run());
    document.getElementById('edit-btn-bullet')?.addEventListener('click', () => editEditor.chain().focus().toggleBulletList().run());
    document.getElementById('edit-btn-ordered')?.addEventListener('click', () => editEditor.chain().focus().toggleOrderedList().run());
    document.getElementById('edit-btn-link')?.addEventListener('click', () => {
      const previousUrl = editEditor.getAttributes('link').href;
      const url = window.prompt('URL del Enlace:', previousUrl);
      if (url === null) return;
      if (url === '') {
        editEditor.chain().focus().extendMarkRange('link').unsetLink().run();
        return;
      }
      editEditor.chain().focus().extendMarkRange('link').setLink({ href: url }).run();
    });
  }

  // Event delegation to capture edit button clicks (works with SSR and dynamically added buttons)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btnEdit = target.closest('.btn-edit-post') as HTMLButtonElement;
    if (btnEdit) {
      const postId = btnEdit.dataset.postId;
      if (!postId) return;
      
      initEditEditor(); 
      currentEditingPostId = postId;
      
      const template = document.getElementById(`raw-content-${postId}`) as HTMLTemplateElement;
      if (template && editEditor) {
        editEditor.commands.setContent(template.innerHTML);
      }
      editModal?.showModal();
    }
  });

  const btnCloseEditModal = document.getElementById('btn-close-edit-modal');
  const btnCancelEdit = document.getElementById('btn-cancel-edit');
  btnCloseEditModal?.addEventListener('click', () => editModal?.close());
  btnCancelEdit?.addEventListener('click', () => editModal?.close());

  // --- Modal de Denuncia ---
  const reportModal = document.getElementById('report-modal') as HTMLDialogElement;
  const reportForm = document.getElementById('report-form');
  const reportPostIdInput = document.getElementById('report-post-id') as HTMLInputElement;
  const reportTargetUserInput = document.getElementById('report-reported-user-id') as HTMLInputElement;
  const reportUserNameSpan = document.getElementById('report-user-name');
  const btnCancelReport = document.getElementById('btn-cancel-report');
  const btnSubmitReport = document.getElementById('btn-submit-report') as HTMLButtonElement;
  const reportErrorBox = document.getElementById('report-error');

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btnReport = target.closest('.btn-report-post') as HTMLButtonElement;
    
    if (btnReport) {
      const postId = btnReport.dataset.postId;
      const reportedUserId = btnReport.dataset.authorId;
      const reportedUserName = btnReport.dataset.authorName;

      if (reportPostIdInput) reportPostIdInput.value = postId || '';
      if (reportTargetUserInput) reportTargetUserInput.value = reportedUserId || '';
      if (reportUserNameSpan) reportUserNameSpan.textContent = reportedUserName || '';
      if (reportErrorBox) reportErrorBox.classList.add('hidden');
      
      reportModal?.showModal();
    }
  });

  btnCancelReport?.addEventListener('click', () => reportModal?.close());

  reportForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!reportErrorBox) return;
    
    reportErrorBox.classList.add('hidden');
    btnSubmitReport.disabled = true;
    btnSubmitReport.textContent = 'Enviando...';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      alert('Debes iniciar sesión para denunciar.');
      window.location.href = '/login';
      return;
    }

    const title = (document.getElementById('report-title') as HTMLInputElement).value;
    const description = (document.getElementById('report-description') as HTMLTextAreaElement).value;
    const reported_user_id = reportTargetUserInput.value;
    const post_id = reportPostIdInput.value;
    const thread_id = window.location.pathname.split('/').pop();

    try {
      const { error } = await supabase
        .from('forum_reports')
        .insert({
          title,
          description,
          reporter_id: session.user.id,
          reported_user_id,
          post_id,
          thread_id
        });

      if (error) throw error;

      alert('Denuncia enviada correctamente. El equipo de moderación la revisará pronto.');
      reportModal.close();
      (reportForm as HTMLFormElement).reset();
    } catch (err: any) {
      reportErrorBox.textContent = 'Error: ' + err.message;
      reportErrorBox.classList.remove('hidden');
    } finally {
      btnSubmitReport.disabled = false;
      btnSubmitReport.textContent = 'Enviar Denuncia';
    }
  });

  const btnSaveEdit = document.getElementById('btn-save-edit') as HTMLButtonElement;
  const editErrorBox = document.getElementById('edit-error');

  btnSaveEdit?.addEventListener('click', async () => {
    if (!editEditor || !currentEditingPostId) return;

    const htmlContent = editEditor.getHTML();
    if (htmlContent === '<p></p>' || editEditor.getText().trim() === '') {
       if (editErrorBox) {
         editErrorBox.textContent = 'El mensaje no puede estar vacío.';
         editErrorBox.classList.remove('hidden');
       }
       return;
    }

    if (editErrorBox) editErrorBox.classList.add('hidden');
    btnSaveEdit.disabled = true;
    btnSaveEdit.textContent = 'Guardando...';

    try {
      const { error } = await supabase
        .from('forum_posts')
        .update({ content: htmlContent })
        .eq('id', currentEditingPostId);
        
      if (error) throw new Error(error.message);

      editModal.close();
      window.location.reload(); 
    } catch (err: any) {
      if (editErrorBox) {
        editErrorBox.textContent = err.message || 'Error al guardar cambios.';
        editErrorBox.classList.remove('hidden');
      }
    } finally {
      btnSaveEdit.disabled = false;
      btnSaveEdit.textContent = 'Guardar Cambios';
    }
  });

  // --- Realtime Subscription ---
  const threadId = window.location.pathname.split('/').pop();
  const postsContainer = document.querySelector('.space-y-8.mb-12');
  const currentUserId = (document.body.dataset.userId) || ''; // Podríamos pasar esto via data-attrs si fuera necesario, o pedirlo a session

  if (postsContainer && threadId) {
    supabase
      .channel(`public:forum_posts:thread:${threadId}`)
      .on('postgres_changes', { 
        event: 'INSERT', 
        schema: 'public', 
        table: 'forum_posts',
        filter: `thread_id=eq.${threadId}` 
      }, async (payload) => {
        // Obtenemos los datos extendidos del post
        const { data: post } = await supabase
          .from('vw_forum_posts')
          .select('*')
          .eq('id', payload.new.id)
          .single();

        if (post) {
          // Función de formato local (duplicada para el cliente)
          const formatTime = (dateStr: string) => {
            const date = new Date(dateStr);
            return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
          };

          // Lógica de renderizado local (YouTube)
          const renderPostContent = (content: string) => {
            const youtubeRegex = /<a [^>]*href=["'](?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})[^"']*["'][^>]*>.*?<\/a>|(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})[^\s<]*/g;
            return content.replace(youtubeRegex, (_match: any, G1: any, G2: any) => {
              const videoId = G1 || G2;
              return `<div class="my-8 aspect-video w-full max-w-3xl overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-black mx-auto"><iframe class="w-full h-full" src="https://www.youtube.com/embed/${videoId}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>`;
            });
          };

          const isStaff = post.author_role === 'admin' || post.author_role === 'instructor';
          const roleLabel = post.author_role === 'admin' ? 'ADMIN' : 'TRAINER';
          const roleColor = post.author_role === 'admin' ? 'bg-rose-500/20 text-rose-400 border-rose-500/30' : 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30';

          const isAuthor = post.user_id === currentUserId;

          const postHtml = `
            <article class="group relative flex flex-col md:flex-row gap-4 md:gap-8 p-6 rounded-2xl border border-white/5 transition-all duration-300 bg-transparent hover:bg-white/[0.02] animate-in fade-in slide-in-from-bottom-4 duration-500">
              <aside class="flex md:flex-col items-center md:items-start gap-3 md:w-40 shrink-0">
                <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl overflow-hidden border-2 border-white/10 group-hover:border-[#008AE6]/50 transition-colors shadow-lg bg-[#111C2A] flex-shrink-0">
                  <img 
                    src="${post.author_avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(post.author_name)}&background=111C2A&color=00A3FF`}" 
                    alt="" 
                    class="w-full h-full object-cover" 
                    onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(post.author_name)}&background=111C2A&color=00A3FF';"
                  />
                </div>
                <div class="md:mt-2 text-center md:text-left w-full">
                  <div class="flex flex-col md:items-start gap-1">
                     <p class="text-sm font-black transition-colors truncate max-w-[120px] md:max-w-none ${isStaff ? 'text-white' : 'text-slate-200 group-hover:text-[#00A3FF]'}">
                      ${post.author_name}
                    </p>
                    ${isStaff ? `<span class="text-[8px] font-black px-1.5 py-0.5 rounded border ${roleColor} tracking-widest w-fit">${roleLabel}</span>` : ''}
                  </div>
                  <p class="text-[9px] font-black text-slate-500 uppercase tracking-tighter opacity-70 mt-1">
                    ${formatTime(post.created_at)}
                  </p>
                </div>
              </aside>
              <div class="flex-1 min-w-0">
                <div class="forum-content max-w-none">
                  <div>${renderPostContent(post.content)}</div>
                </div>

                ${post.location_lat && post.location_lng ? `
                  <div class="mt-4 p-4 bg-[#0F172A] border border-white/5 rounded-xl max-w-2xl">
                    <div class="flex items-center gap-2 mb-3">
                      <svg class="w-5 h-5 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                      <h4 class="text-sm font-bold text-white uppercase tracking-widest">Ubicación de la Quedada</h4>
                    </div>
                    ${post.location_address && !post.location_address.includes('toFixed') ? `<p class="text-xs text-slate-400 mb-3">${post.location_address}</p>` : ''}
                    <div class="w-full aspect-[4/3] rounded-lg overflow-hidden bg-[#111C2A] border border-white/10 mb-3 flex items-center justify-center p-4 text-center">
                      <p class="text-xs text-slate-500 font-bold uppercase tracking-widest leading-relaxed">
                        Ubicación disponible.<br/>(Recarga la página para previsualizar el mapa)
                      </p>
                    </div>
                    <div class="flex">
                      <a href="https://www.google.com/maps/dir/?api=1&destination=${post.location_lat},${post.location_lng}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-[#00A3FF]/10 text-[#00A3FF] hover:bg-[#00A3FF] hover:text-black font-bold text-xs rounded-lg transition-colors border border-[#00A3FF]/20">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        Obtener Indicaciones
                      </a>
                    </div>
                  </div>
                ` : ''}

                <div class="flex justify-end gap-2 mt-4">
                 ${isAuthor ? `
                 <button class="btn-edit-post p-1.5 text-slate-600 hover:text-[#00A3FF] hover:bg-[#00A3FF]/10 rounded transition-all" data-post-id="${post.id}" data-author-id="${post.user_id}" title="Editar Respuesta">
                   <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                   <template id="raw-content-${post.id}">${post.content}</template>
                 </button>
                 ` : ''}
                 ${(isAuthor || isStaff) ? `
                 <button class="btn-delete-post p-1.5 text-slate-600 hover:text-rose-500 hover:bg-rose-500/10 rounded transition-all" data-post-id="${post.id}" data-author-id="${post.user_id}" title="Eliminar Respuesta">
                   <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                 </button>
                 ` : ''}
               </div>
              </div>
            </article>
          `;
          postsContainer.insertAdjacentHTML('beforeend', postHtml);
          
          // Scroll suave hasta el nuevo mensaje si no fue el usuario actual quien lo envió
          // (Aunque generalmente es mejor que aparezca y ya)
        }
      })
      .on('postgres_changes', { 
        event: 'DELETE', 
        schema: 'public', 
        table: 'forum_posts'
      }, (payload) => {
        const deletedId = payload.old.id;
        const article = document.querySelector(`[data-post-id="${deletedId}"]`)?.closest('article');
        if (article) {
          article.classList.add('opacity-0', 'scale-95');
          setTimeout(() => article.remove(), 300);
        }
      })
      .subscribe();
  }

  // --- Initialize Static Maps for Posts ---
  if (typeof (window as any).L !== 'undefined') {
    document.querySelectorAll('.static-map-container').forEach((el, index) => {
      const container = el as HTMLElement;
      const lat = parseFloat(container.dataset.lat || '0');
      const lng = parseFloat(container.dataset.lng || '0');
      const mapId = 'static-map-' + index;
      container.id = mapId;
      
      const staticMap = (window as any).L.map(mapId, {
        center: [lat, lng],
        zoom: 15,
        attributionControl: false
      });
      (window as any).L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(staticMap);
      (window as any).L.marker([lat, lng]).addTo(staticMap);
    });
  }
</script>

<style is:global>
  /* Premium Prose-like styles manually defined for better control */
  .forum-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #cbd5e1; /* slate-300 */
  }
  .forum-content p {
    margin-bottom: 1.5rem;
  }
  .forum-content strong {
    color: #f8fafc; /* slate-50 */
    font-weight: 800;
  }
  .forum-content em {
    color: #e2e8f0; /* slate-200 */
    font-style: italic;
  }
  .forum-content a {
    color: #00A3FF;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
    transition: color 0.2s;
  }
  .forum-content a:hover {
    color: #60c5ff;
  }
  .forum-content ul {
    list-style-type: none;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .forum-content ul li {
    position: relative;
    margin-bottom: 0.5rem;
  }
  .forum-content ul li::before {
    content: "";
    position: absolute;
    left: -1.25rem;
    top: 0.6rem;
    width: 6px;
    height: 6px;
    background-color: #00A3FF;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(0, 163, 255, 0.6);
  }
  .forum-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: #94a3b8; /* slate-400 */
  }
  .forum-content ol li {
    margin-bottom: 0.5rem;
    padding-left: 0.5rem;
  }
  .forum-content ol li::marker {
    color: #00A3FF;
    font-weight: 800;
  }
</style>
