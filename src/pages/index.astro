---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

// Dark blue/grey urban jumping 

import { supabase } from '../lib/supabase';
import { getAndSyncMuxDuration } from '../lib/muxApi';

let ultimosVideos = [];
try {
  const { data, error } = await supabase
    .from('videos')
    .select('id, titulo, descripcion, dificultad, creado_en, mux_playback_id, mux_asset_id, duracion')
    .eq('estado', 'listo')
    .order('creado_en', { ascending: false })
    .limit(2);
    
  if (error) throw error;
  ultimosVideos = await getAndSyncMuxDuration(data || []);
} catch (e) {
  console.error('Error al obtener lo nuevo de BD:', e);
}

const NUEVOS_DE_BD = ultimosVideos.map((v: any) => ({
  id: v.id,
  title: v.titulo,
  tag: v.dificultad?.toUpperCase() || "INTERMEDIO",
  time: v.duracion ? `${Math.floor(v.duracion / 60).toString().padStart(2, '0')}:${(v.duracion % 60).toString().padStart(2, '0')}` : "00:00",
  img: v.mux_playback_id ? `https://image.mux.com/${v.mux_playback_id}/thumbnail.webp?time=1&width=600` : "https://images.unsplash.com/photo-1549476464-37392f717541?q=80&w=1000&auto=format&fit=crop"
}));

const LO_NUEVO = NUEVOS_DE_BD;

// Preparar los datos del video principal (HERO)
const heroVideo = ultimosVideos[0];
const HERO_TITLE = heroVideo ? heroVideo.titulo.toUpperCase() : "DOMINA EL\nFLOW URBANO";
const HERO_DESC = heroVideo?.descripcion ? heroVideo.descripcion : "Lleva tu movimiento a las calles. Aprende los principios fundamentales del flujo, el impulso y la conciencia espacial de la mano de traceurs de clase mundial.";
const HERO_BG = heroVideo?.mux_playback_id ? `https://image.mux.com/${heroVideo.mux_playback_id}/thumbnail.webp?time=1` : "https://images.unsplash.com/photo-1541252862376-79dbf4fbbda0?q=80&w=2670&auto=format&fit=crop";
const HERO_LINK = heroVideo?.id ? `/reproductor?id=${heroVideo.id}` : "/reproductor";

const CATEGORIAS = [
  { name: "PARKOUR", img: "/img/parkour-category.png" },
  { name: "TRICKING", img: "https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?q=80&w=600&auto=format&fit=crop" },
  { name: "ACROBACIAS", img: "/img/acrobacias-category.png" },
  { name: "FUERZA", img: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=600&auto=format&fit=crop" }
];
---

<Layout title="Inicio">
  <Nav />
  
  <main class="w-full">
    <!-- Hero Section -->
    <section class="relative w-full h-[85vh] flex items-center bg-black overflow-hidden group">
      <!-- Background Image with Gradients for blending -->
      <div class="absolute inset-0 w-full h-full">
        <img src={HERO_BG} alt="Hero Background" class="w-full h-full object-cover object-center opacity-70 group-hover:scale-[1.02] transition-transform duration-1000" />
        <!-- Inner shadow / vignette to match dark theme -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#0F172A] via-[#0F172A]/70 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0F172A] via-transparent to-transparent"></div>
      </div>
      
      <!-- Let's drop Content -->
      <div class="relative z-10 container mx-auto px-8 max-w-7xl animate-fade-in">
        <div class="max-w-xl">
          <span class="inline-block border border-[#00A3FF] text-[#00E5FF] text-xs font-bold px-3 py-1 rounded mb-4 tracking-widest bg-[#00A3FF]/10 backdrop-blur-sm">RECIÉN LANZADO</span>
          
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white leading-[0.9] tracking-tight mb-6 uppercase" style="white-space: pre-line;">
            {HERO_TITLE.split('\\n').map((line, i, arr) => (
              <>
                {i === arr.length - 1 ? <span class="text-gradient">{line}</span> : line}
                {i < arr.length - 1 && <br/>}
              </>
            ))}
          </h1>
          
          <p class="text-lg text-slate-300 font-medium mb-10 max-w-lg leading-relaxed line-clamp-3">
            {HERO_DESC}
          </p>
          
          <div class="flex items-center gap-4">
            <a href={HERO_LINK} class="btn-primary flex items-center gap-2 px-8 py-3 text-lg group w-fit">
              <svg class="w-5 h-5 fill-current transition-transform group-hover:translate-x-1" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              VER 
            </a>
            <button class="btn-secondary px-8 py-3 text-lg hover:bg-white/10 hover:border-white/20 transition-all border-white/10 bg-black/40 backdrop-blur-md">
              <svg class="w-5 h-5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
              MI LISTA
            </button>
          </div>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-8 max-w-[1400px]">
      
      <!-- Seguir Viendo -->
      <section id="seguir-viendo-section" class="py-12 mt-8 animate-fade-in hidden" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold tracking-tight">SEGUIR <span class="text-[#00A3FF]">VIENDO</span></h2>
          <a href="/entrenamiento" class="text-sm font-semibold text-slate-400 hover:text-[#00A3FF] transition-colors flex items-center gap-1">
            VER TODO <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
        
        <div id="seguir-viendo-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Dynamically populated from JS -->
        </div>
      </section>

      <!-- Nuevo en Freedom -->
      {LO_NUEVO.length > 0 && (
      <section class="py-12 animate-fade-in" style="animation-delay: 0.2s;">
        <div class="mb-6">
          <h2 class="text-2xl font-bold tracking-tight">LO NUEVO EN <span class="text-[#00A3FF]">FREEDOM</span></h2>
          <p class="text-sm text-slate-400">Nuevas técnicas añadidas esta semana</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative">
          
          <!-- Arrows mock (visual only) -->
          <div class="absolute -right-6 -top-14 flex items-center gap-2">
            <button class="w-next h-10 w-10 flex items-center justify-center border border-slate-700 text-slate-500 hover:text-white hover:border-[#00A3FF] rounded-full transition-colors"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button>
            <button class="w-next h-10 w-10 flex items-center justify-center border border-[#00A3FF] text-[#00A3FF] hover:bg-[#00A3FF] hover:text-white rounded-full transition-colors shadow-lg shadow-[#00A3FF]/20"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>
          </div>

          {LO_NUEVO.map((item) => (
            <a href={item.id ? `/reproductor?id=${item.id}` : "/reproductor"} class="group cursor-pointer relative rounded-2xl overflow-hidden aspect-[16/9] border border-white/5 mx-auto w-full max-w-2xl transform transition-transform duration-500 hover:scale-[1.02] hover:shadow-2xl hover:shadow-[#00A3FF]/20 block">
               <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent z-10 pointer-events-none opacity-80 group-hover:opacity-90 transition-opacity"></div>
               <img src={item.img} alt={item.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"/>
               
               <div class="absolute bottom-0 left-0 p-8 z-20 w-full">
                  <span class="inline-block bg-[#00A3FF]/20 text-[#0EEDFF] text-xs font-bold px-3 py-1 rounded backdrop-blur border border-[#00A3FF]/30 mb-3">{item.tag}</span>
                  <h3 class="text-2xl md:text-3xl font-black text-white mb-2 leading-tight drop-shadow-lg">{item.title}</h3>
                  <div class="flex items-center gap-4 text-sm font-medium text-slate-300">
                    <span class="flex items-center gap-1"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> {item.time}</span>
                  </div>
               </div>
               <!-- Play Icon centered -->
               <div class="absolute inset-0 flex items-center justify-center z-20">
                 <div class="w-16 h-16 rounded-full bg-white/10 backdrop-blur border border-white/20 flex items-center justify-center text-white scale-0 group-hover:scale-100 transition-transform duration-300">
                    <svg class="w-6 h-6 fill-current ml-1" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                 </div>
               </div>
            </a>
          ))}
        </div>
      </section>
      )}

      <!-- Explorar por Categoría -->
      <section class="py-12 mb-20 animate-fade-in" style="animation-delay: 0.3s;">
        <h2 class="text-2xl font-bold tracking-tight mb-8">EXPLORAR POR <span class="text-[#00A3FF]">CATEGORÍA</span></h2>
        
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
          {CATEGORIAS.map((cat) => (
            <a href={`/catalogo?cat=${encodeURIComponent(cat.name)}`} class="group cursor-pointer relative aspect-[4/5] rounded-2xl overflow-hidden bg-slate-800 border-2 border-transparent hover:border-[#008AE6] transition-all duration-300 shadow-lg">
              <!-- Imagen de fondo -->
              <img src={cat.img} alt={cat.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"/>
              
              <!-- Capa oscura base -->
              <div class="absolute inset-0 bg-black/30 group-hover:bg-black/10 transition-colors z-10"></div>

              <!-- Gradiente inferior para legibilidad del texto -->
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10"></div>
              
              <!-- Icono centrado (sube en hover) -->
              <div class="absolute inset-0 flex items-center justify-center z-20 pb-12">
                <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 rounded-full flex items-center justify-center backdrop-blur-sm border border-white/20 transform group-hover:-translate-y-2 transition-transform duration-300 shadow-[0_0_20px_rgba(0,163,255,0.2)]">
                  <svg class="w-5 h-5 md:w-6 md:h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M12 2v2"/></svg>
                </div>
              </div>

              <!-- Título en la parte inferior -->
              <div class="absolute inset-x-0 bottom-0 z-20 p-3 md:p-4">
                <h3 class="font-black text-base md:text-lg lg:text-xl tracking-wider text-white text-center leading-tight drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] group-hover:text-[#00E5FF] transition-colors">{cat.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>
  </main>
  
  <!-- Footer -->
  <footer class="border-t border-slate-800 bg-[#0b1016]">
    <div class="container mx-auto px-8 py-10 flex flex-col md:flex-row items-center justify-between">
      <div class="flex items-center gap-2 mb-4 md:mb-0">
         <svg class="w-6 h-6 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M12 2v2"/></svg>
        <span class="font-bold tracking-wide text-slate-300">FREEDOM MOVEMENT LAB</span>
      </div>
      <div class="flex gap-8 text-sm text-slate-500 font-medium">
        <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/terminos" class="hover:text-white transition-colors">Términos</a>
        <a href="mailto:soporte@freedomacademygym.com" class="hover:text-white transition-colors">Soporte</a>
        <a href="mailto:soporte@freedomacademygym.com" class="hover:text-white transition-colors">Contacto</a>
      </div>
      <p class="text-xs text-slate-600 mt-6 md:mt-0 font-medium tracking-widest uppercase">
        © 2026 FREEDOM MOVEMENT LAB. <span class="text-slate-500">ROMPE LOS LÍMITES.</span>
      </p>
    </div>
  </footer>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function loadWatchHistory() {
    const section = document.getElementById('seguir-viendo-section');
    const grid = document.getElementById('seguir-viendo-grid');
    if (!section || !grid) return;

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return; // Oculto si no hay sesión

      // Cargar historial
      const { data: historial, error } = await supabase
        .from('historial_videos')
        .select(`
          tiempo_actual, completado, actualizado_en,
          videos!inner ( id, titulo, mux_playback_id, duracion, dificultad )
        `)
        .eq('usuario_id', session.user.id)
        .eq('completado', false)
        .order('actualizado_en', { ascending: false })
        .limit(4);

      if (error) throw error;
      if (!historial || historial.length === 0) {
        section.classList.remove('hidden');
        grid.innerHTML = `
          <div class="col-span-1 md:col-span-2 lg:col-span-4 flex flex-col items-center justify-center py-16 text-center bg-[#111C2A] rounded-2xl border border-white/5 shadow-inner">
            <svg class="w-16 h-16 text-[#00A3FF]/40 mb-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
            </svg>
            <h3 class="text-2xl font-bold text-white mb-2">Aún no has empezado a entrenar.</h3>
            <p class="text-slate-400 font-medium mb-8 max-w-md mx-auto">¡Explora nuestro catálogo para encontrar los mejores tutoriales y lleva tu movimiento al siguiente nivel!</p>
            <a href="/catalogo" class="btn-primary inline-flex items-center gap-3 px-8 py-3.5 text-sm font-bold shadow-[0_0_20px_rgba(0,163,255,0.3)] hover:-translate-y-1 transition-transform">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              Explorar Catálogo
            </a>
          </div>
        `;
        return;
      }

      // Hay videos para ver
      section.classList.remove('hidden');
      
      let html = '';
      for (const reg of historial) {
        const video = (reg as any).videos;
        const img = video.mux_playback_id 
          ? `https://image.mux.com/${video.mux_playback_id}/thumbnail.webp?time=${reg.tiempo_actual || 1}&width=600`
          : "https://images.unsplash.com/photo-1599058917212-97d14a72d4ae?q=80&w=600&auto=format&fit=crop";
        
        let progressPct = 0;
        let diffStr = "SEGUIR VIENDO";
        if (video.duracion && video.duracion > 0) {
           progressPct = Math.min(100, Math.round((reg.tiempo_actual / video.duracion) * 100));
           const leftMin = Math.round((video.duracion - reg.tiempo_actual) / 60);
           if (leftMin > 0) diffStr = `${leftMin}M RESTANTES`;
        } else if (reg.tiempo_actual > 0) {
           progressPct = 50; // Mock fake value if duration doesn't exist yet but has time
           diffStr = `MIN ${(reg.tiempo_actual / 60).toFixed(1)} `;
        }

        html += `
          <a href="/reproductor?id=${video.id}" class="group block cursor-pointer">
            <div class="relative w-full aspect-[16/9] rounded-xl overflow-hidden mb-3 border border-white/5 transition-all duration-300 shadow-lg shadow-black/40 group-hover:shadow-[#00A3FF]/20 group-hover:border-[#008AE6]/50">
              <img src="${img}" alt="${video.titulo}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent z-10 pointer-events-none opacity-80 group-hover:opacity-90 transition-opacity"></div>
              <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-20">
                <div class="w-12 h-12 rounded-full bg-[#00A3FF]/90 flex items-center justify-center text-white backdrop-blur shadow-xl scale-90 group-hover:scale-100 transition-transform">
                   <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
              <div class="absolute bottom-0 left-0 w-full h-1 bg-slate-800">
                <div class="h-full bg-[#00A3FF]" style="width: ${progressPct}%;"></div>
              </div>
            </div>
            <h3 class="font-bold text-slate-100 group-hover:text-white transition-colors truncate">${video.titulo}</h3>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest truncate">${video.dificultad || 'VÍDEO'} • ${diffStr}</p>
          </a>
        `;
      }
      grid.innerHTML = html;
      
    } catch(err) {
      console.error('Error cargando seguir viendo:', err);
    }
  }

  loadWatchHistory();
</script>
