---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="¡Bienvenido a Freedom Pro! | Freedom Movement Lab">
  <Nav />

  <main class="min-h-screen bg-[#0b1016] flex items-center justify-center px-6 py-20">
    <div class="max-w-lg w-full text-center">

      <!-- Ícono de Éxito Animado -->
      <div class="relative w-28 h-28 mx-auto mb-8">
        <!-- Anillos pulsantes -->
        <div class="absolute inset-0 rounded-full bg-emerald-500/10 animate-ping"></div>
        <div class="absolute inset-2 rounded-full bg-emerald-500/10 animate-ping" style="animation-delay: 0.15s;"></div>
        <!-- Círculo principal -->
        <div class="relative w-28 h-28 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center shadow-[0_0_40px_rgba(52,211,153,0.4)]">
          <svg class="w-14 h-14 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path class="check-path" d="M20 6 9 17l-5-5"/>
          </svg>
        </div>
      </div>

      <!-- Texto Principal -->
      <div class="mb-3 inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full px-4 py-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-emerald-400 text-xs font-bold uppercase tracking-wider">Plan Activado</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-black text-white mb-4 leading-tight">
        ¡Bienvenido a<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-[#00E5FF]">Freedom Pro!</span>
      </h1>

      <p class="text-slate-400 text-lg font-medium mb-2">
        Tu suscripción ya está activa. Tienes acceso completo a todo el contenido de entrenamiento.
      </p>
      <p class="text-slate-600 text-sm mb-10">
        Si el acceso no se activa de inmediato, espera unos segundos y recarga la página.
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/catalogo" id="btn-catalogo"
           class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-[#00A3FF] to-[#0080CC] hover:from-[#0090EE] hover:to-[#006BB3] text-white font-bold text-base py-4 px-8 rounded-2xl transition-all duration-200 shadow-[0_0_20px_rgba(0,163,255,0.3)] hover:shadow-[0_0_30px_rgba(0,163,255,0.5)] active:scale-[0.98]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          Explorar el Catálogo
        </a>
        <a href="/perfil"
           class="inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 border border-white/10 hover:border-white/20 text-white font-bold text-base py-4 px-8 rounded-2xl transition-all duration-200 active:scale-[0.98]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Ver mi Perfil
        </a>
      </div>

      <!-- Info extra -->
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-md mx-auto">
        {[
          { icon: 'M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4 12 14.01 9 11.01', label: 'Acceso ilimitado' },
          { icon: 'M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z M4 22v-7', label: 'Cancela cuando quieras' },
          { icon: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z', label: 'Activo al instante' },
        ].map(item => (
          <div class="bg-[#111C2A] border border-white/5 rounded-2xl p-4 text-center">
            <svg class="w-6 h-6 text-emerald-400 mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d={item.icon}/>
            </svg>
            <p class="text-xs font-semibold text-slate-400">{item.label}</p>
          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>

<style>
  @keyframes draw-check {
    from { stroke-dashoffset: 30; }
    to { stroke-dashoffset: 0; }
  }
  .check-path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: draw-check 0.5s ease-out 0.3s forwards;
  }
</style>
