---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Stripe from 'stripe';

// Obtener el precio real desde Stripe en el servidor
let precioFormateado = '--';
let intervaloFormateado = 'mes';

try {
  const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY as string, {
    apiVersion: '2026-04-22.dahlia',
  });

  const priceId = import.meta.env.STRIPE_PRICE_MENSUAL as string;
  console.log('[precios] Obteniendo precio de Stripe, priceId:', priceId);

  const price = await stripe.prices.retrieve(priceId);
  console.log('[precios] Precio obtenido:', price.unit_amount, price.currency);

  if (price.unit_amount && price.currency) {
    precioFormateado = new Intl.NumberFormat('es-ES', {
      style: 'currency',
      currency: price.currency.toUpperCase(),
      minimumFractionDigits: 0,
      maximumFractionDigits: 2,
    }).format(price.unit_amount / 100);

    // Intervalo del precio (month -> mes, year -> año)
    const intervaloMap: Record<string, string> = {
      month: 'mes',
      year: 'a\u00f1o',
      week: 'semana',
      day: 'd\u00eda',
    };
    intervaloFormateado = intervaloMap[price.recurring?.interval ?? 'month'] ?? 'mes';
  }
} catch (e: any) {
  console.error('[precios] ❌ Error obteniendo precio de Stripe:', e?.message ?? e);
  console.error('[precios]    STRIPE_SECRET_KEY empieza por:', (import.meta.env.STRIPE_SECRET_KEY as string)?.substring(0, 12));
  console.error('[precios]    STRIPE_PRICE_MENSUAL:', import.meta.env.STRIPE_PRICE_MENSUAL);
}
---

<Layout title="Plan de Acceso | Freedom Movement Lab">
  <Nav />

  <main class="min-h-screen bg-[#0b1016] pb-24 pt-8">

    <!-- Hero -->
    <div class="text-center max-w-2xl mx-auto px-6 mb-16">
      <div class="inline-flex items-center gap-2 bg-[#00A3FF]/10 border border-[#00A3FF]/20 rounded-full px-4 py-1.5 mb-6">
        <svg class="w-4 h-4 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span class="text-[#00A3FF] text-xs font-bold uppercase tracking-wider">Acceso Total</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-black text-white mb-4 leading-tight">
        Entrena sin límites.<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00A3FF] to-[#00E5FF]">Un plan. Todo el contenido.</span>
      </h1>
      <p class="text-slate-400 text-lg font-medium">
        Desbloquea todos los vídeos de entrenamiento, accede a técnicas exclusivas y sigue aprendiendo a tu ritmo.
      </p>
    </div>

    <!-- Pricing Card -->
    <div class="max-w-lg mx-auto px-6">
      <div id="pricing-card" class="relative bg-gradient-to-b from-[#111C2A] to-[#0d1520] border border-[#00A3FF]/30 rounded-3xl p-8 shadow-[0_0_60px_rgba(0,163,255,0.12)] overflow-hidden">

        <!-- Glow Decoration -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-64 h-1 bg-gradient-to-r from-transparent via-[#00A3FF] to-transparent rounded-full opacity-60"></div>

        <!-- Badge Popular -->
        <div class="absolute top-6 right-6 bg-[#00A3FF] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full shadow-[0_0_15px_rgba(0,163,255,0.4)]">
          MÁS POPULAR
        </div>

        <!-- Plan Name -->
        <div class="mb-6">
          <p class="text-[#00A3FF] text-xs font-bold uppercase tracking-wider mb-1">Plan Freedom Pro</p>
          <div class="flex items-baseline gap-2">
            <span class="text-5xl font-black text-white">{precioFormateado}</span>
            <span class="text-slate-400 font-medium">/{intervaloFormateado}</span>
          </div>
          <p class="text-slate-500 text-sm mt-1">Cancela cuando quieras. Sin permanencia.</p>
        </div>

        <!-- Divider -->
        <div class="border-t border-white/5 mb-6"></div>

        <!-- Benefits -->
        <ul class="space-y-3 mb-8">
          {[
            'Acceso ilimitado a todos los vídeos',
            'Técnicas de Parkour, Calistenia y más',
            'Contenido nuevo cada semana',
            'Progreso guardado en todos tus dispositivos',
            'Historial completo de entrenamiento',
            'Cancela en cualquier momento sin penalizaciones',
          ].map(b => (
            <li class="flex items-center gap-3 text-sm font-medium text-slate-300">
              <div class="w-5 h-5 rounded-full bg-[#00A3FF]/15 border border-[#00A3FF]/30 flex items-center justify-center flex-shrink-0">
                <svg class="w-3 h-3 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              {b}
            </li>
          ))}
        </ul>

        <!-- CTA Button -->
        <div id="cta-container">
          <!-- Se rellena por JS según el estado del usuario -->
          <div class="h-14 bg-slate-800 animate-pulse rounded-2xl"></div>
        </div>

        <!-- Stripe Badge -->
        <div class="flex items-center justify-center gap-2 mt-5">
          <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span class="text-xs text-slate-500 font-medium">Pago seguro gestionado por <strong class="text-slate-400">Stripe</strong></span>
        </div>
      </div>

      <!-- Estado activo (oculto por defecto) -->
      <div id="active-plan-card" class="hidden mt-6 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl p-5 flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <p class="font-bold text-emerald-400 text-sm">Tu plan está activo</p>
          <p class="text-slate-400 text-xs mt-0.5">Tienes acceso completo a todo el contenido de Freedom Movement Lab.</p>
        </div>
      </div>

      <!-- Nota de garantía -->
      <p class="text-center text-xs text-slate-600 mt-6 font-medium">
        Al suscribirte aceptas los <a href="/terminos" class="text-slate-500 hover:text-white transition-colors underline">Términos de Servicio</a> y la <a href="/privacidad" class="text-slate-500 hover:text-white transition-colors underline">Política de Privacidad</a>.
      </p>
    </div>

    <!-- FAQ: un único desplegable al final -->
    <div class="max-w-lg mx-auto px-6 mt-14 mb-4">
      <div class="border-t border-white/5 pt-6">
        <details class="group faq-root">
          <summary class="flex items-center justify-between cursor-pointer list-none select-none py-1 px-1">
            <span class="text-[11px] text-slate-600 uppercase tracking-widest font-bold group-hover:text-slate-500 transition-colors">Preguntas frecuentes</span>
            <svg class="w-3 h-3 text-slate-600 flex-shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>

          <div class="mt-3 space-y-0">
            {[
              {
                q: '¿Puedo cancelar cuando quiera?',
                a: 'Sí, puedes cancelar en cualquier momento desde el portal de gestión. No hay permanencia ni penalizaciones. Seguirás teniendo acceso hasta el final del período facturado.'
              },
              {
                q: '¿Qué métodos de pago aceptáis?',
                a: 'Aceptamos todas las tarjetas principales (Visa, Mastercard, American Express) a través de Stripe.'
              },
              {
                q: '¿El acceso es inmediato?',
                a: 'Sí. En cuanto el pago se confirma, tu acceso se activa automáticamente en segundos.'
              },
              {
                q: '¿Los instructores necesitan suscripción?',
                a: 'No. El personal de Freedom Movement Lab tiene acceso permanente sin suscripción.'
              },
            ].map(faq => (
              <details class="group/q faq-item">
                <summary class="flex items-center justify-between py-2.5 px-1 cursor-pointer list-none select-none">
                  <span class="text-xs text-slate-500 group-hover/q:text-slate-400 transition-colors font-medium">{faq.q}</span>
                  <svg class="w-3 h-3 text-slate-600 flex-shrink-0 ml-4 transition-transform group-open/q:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <p class="text-[11px] text-slate-600 leading-relaxed px-1 pb-3 pt-0.5">{faq.a}</p>
              </details>
            ))}
          </div>
        </details>
      </div>
    </div>

  </main>

  <footer class="border-t border-slate-800 bg-[#0F172A]">
    <div class="container mx-auto px-8 py-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 font-medium">
      <p>© 2026 Freedom movement. Rompe los límites.</p>
      <div class="flex gap-6 mt-4 md:mt-0">
        <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/terminos" class="hover:text-white transition-colors">Términos</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const ctaContainer = document.getElementById('cta-container');
  const activePlanCard = document.getElementById('active-plan-card');

  let isLoading = false;


  async function inicializar() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      // No logueado: botón redirige a login
      renderCTA('login');
      return;
    }

    // Verificar si tiene acceso activo
    const { data: perfil } = await supabase
      .from('perfiles')
      .select('tiene_acceso, rol')
      .eq('id', session.user.id)
      .maybeSingle();

    // Admins e instructores tienen acceso permanente
    if (perfil?.rol === 'instructor' || perfil?.rol === 'admin') {
      renderCTA('staff');
      return;
    }

    if (perfil?.tiene_acceso === true) {
      renderCTA('active');
      return;
    }

    renderCTA('subscribe');
  }

  function renderCTA(estado: 'login' | 'subscribe' | 'active' | 'staff') {
    if (!ctaContainer) return;

    if (estado === 'login') {
      ctaContainer.innerHTML = `
        <a href="/login" id="btn-go-login"
           class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-[#00A3FF] to-[#0080CC] hover:from-[#0090EE] hover:to-[#006BB3] text-white font-bold text-base py-4 px-6 rounded-2xl transition-all duration-200 shadow-[0_0_20px_rgba(0,163,255,0.3)] hover:shadow-[0_0_30px_rgba(0,163,255,0.5)] active:scale-[0.98]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Inicia sesión para suscribirte
        </a>
      `;
    } else if (estado === 'subscribe') {
      ctaContainer.innerHTML = `
        <button id="btn-checkout"
           class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-[#00A3FF] to-[#0080CC] hover:from-[#0090EE] hover:to-[#006BB3] text-white font-bold text-base py-4 px-6 rounded-2xl transition-all duration-200 shadow-[0_0_20px_rgba(0,163,255,0.3)] hover:shadow-[0_0_30px_rgba(0,163,255,0.5)] active:scale-[0.98]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Activar Plan Pro
        </button>
      `;
      document.getElementById('btn-checkout')?.addEventListener('click', iniciarCheckout);
    } else if (estado === 'active') {
      // Mostrar tarjeta de activo y botón de gestión
      if (activePlanCard) {
        activePlanCard.classList.remove('hidden');
        activePlanCard.classList.add('flex');
      }
      ctaContainer.innerHTML = `
        <button id="btn-portal"
           class="w-full flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 border border-white/10 hover:border-white/20 text-white font-bold text-base py-4 px-6 rounded-2xl transition-all duration-200 active:scale-[0.98]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
          Gestionar mi suscripción
        </button>
      `;
      document.getElementById('btn-portal')?.addEventListener('click', abrirPortal);
    } else if (estado === 'staff') {
      ctaContainer.innerHTML = `
        <div class="w-full flex items-center justify-center gap-3 bg-[#EAB308]/10 border border-[#EAB308]/30 text-[#EAB308] font-bold text-sm py-4 px-6 rounded-2xl">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Acceso de staff – no necesitas suscripción
        </div>
      `;
    }
  }

  async function iniciarCheckout() {
    if (isLoading) return;
    isLoading = true;

    const btn = document.getElementById('btn-checkout') as HTMLButtonElement;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `
        <svg class="w-5 h-5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/></svg>
        Redirigiendo a Stripe...
      `;
    }

    try {
      // Obtener el token de sesión activo
      const { data: { session } } = await supabase.auth.getSession();
      const token = session?.access_token ?? '';

      const res = await fetch('/api/create-checkout', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
      });
      const json = await res.json();

      if (!res.ok || !json.url) {
        throw new Error(json.error || 'No se pudo iniciar el checkout');
      }

      window.location.href = json.url;
    } catch (err: any) {
      isLoading = false;
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Activar Plan Pro
        `;
      }
      alert('Error: ' + err.message);
    }
  }

  async function abrirPortal() {
    const btn = document.getElementById('btn-portal') as HTMLButtonElement;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Abriendo portal...';
    }

    try {
      // Obtener el token de sesión activo
      const { data: { session } } = await supabase.auth.getSession();
      const token = session?.access_token ?? '';

      const res = await fetch('/api/customer-portal', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
      });
      const json = await res.json();

      if (!res.ok || !json.url) {
        throw new Error(json.error || 'No se pudo abrir el portal');
      }

      window.location.href = json.url;
    } catch (err: any) {
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Gestionar mi suscripción';
      }
      alert('Error: ' + err.message);
    }
  }

  inicializar();
</script>

<style>
  details summary::-webkit-details-marker { display: none; }
  .faq-item + .faq-item { border-top: 1px solid rgba(255,255,255,0.04); }
</style>
