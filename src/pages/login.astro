---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Acceder | Freedom Movement Lab">
  <!-- Minimal header without auth options avoiding infinite loops/visual bugs -->
  <header class="sticky top-0 z-50 w-full bg-[#0F172A]/90 backdrop-blur-md border-b border-white/5 py-4 px-8 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group mx-auto">
      <svg class="w-8 h-8 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 14 4-4"/>
        <path d="M3.34 19a10 10 0 1 1 17.32 0"/>
        <path d="M12 2v2"/>
      </svg>
      <span class="font-bold text-lg tracking-wide uppercase">Freedom Movement Lab</span>
    </a>
  </header>

  <main class="flex items-center justify-center min-h-[calc(100vh-73px)] py-12 px-4 bg-[#0b1016] relative overflow-hidden">
    <!-- Glow Effects -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[#00A3FF]/10 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="w-full max-w-md bg-[#111C2A] p-8 md:p-10 rounded-3xl border border-white/10 shadow-2xl relative z-10 transition-all" id="auth-container">
      
      <!-- Titulos -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-black text-white tracking-tight mb-2" id="auth-title">Inicia Sesión</h1>
        <p class="text-sm font-medium text-slate-400" id="auth-subtitle">Accede a tu cuenta de Freedom para continuar tu entrenamiento.</p>
      </div>

      <!-- Formularios -->
      <form id="auth-form" class="flex flex-col gap-5">
        
        <div class="flex flex-col gap-2 relative">
          <label class="text-xs font-bold text-slate-400 uppercase tracking-widest pl-1">Correo Electrónico</label>
          <div class="relative">
            <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <input type="email" id="email" name="email" class="w-full bg-[#1E293B] border border-white/10 text-white pl-10 pr-4 py-3 rounded-xl focus:outline-none focus:border-[#008AE6] transition-colors" placeholder="tu@correo.com" required>
          </div>
        </div>

        <div class="flex flex-col gap-2 relative">
          <label class="text-xs font-bold text-slate-400 uppercase tracking-widest pl-1">Contraseña</label>
          <div class="relative">
            <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" id="password" name="password" class="w-full bg-[#1E293B] border border-white/10 text-white pl-10 pr-4 py-3 rounded-xl focus:outline-none focus:border-[#008AE6] transition-colors" placeholder="••••••••" required>
          </div>
        </div>

        <div id="error-message" class="hidden bg-rose-500/10 border border-rose-500/50 text-rose-500 text-sm font-semibold rounded-lg p-3 text-center">
          Credenciales incorrectas.
        </div>

        <button type="submit" id="submit-btn" class="btn-primary w-full py-3.5 mt-2 rounded-xl text-[15px] shadow-[0_0_20px_rgba(0,163,255,0.2)]">
          Entrar a mi cuenta
        </button>
      </form>

      <!-- Divisor -->
      <div class="relative flex items-center py-6">
        <div class="flex-grow border-t border-white/10"></div>
        <span class="flex-shrink-0 mx-4 text-xs font-bold text-slate-500 uppercase tracking-widest">O continúa con</span>
        <div class="flex-grow border-t border-white/10"></div>
      </div>

      <!-- Google Button -->
      <button id="google-login-btn" type="button" class="w-full bg-white text-black hover:bg-slate-200 py-3 rounded-xl text-sm font-bold transition-colors flex items-center justify-center gap-3">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Entrar con Google
      </button>

      <!-- Toggle Mode -->
      <div class="mt-8 text-center text-sm font-medium text-slate-400">
        <span id="toggle-text">¿No tienes cuenta?</span> 
        <button type="button" id="toggle-mode-btn" class="font-bold text-white hover:text-[#00A3FF] transition-colors ml-1 focus:outline-none">Regístrate gratis</button>
      </div>

    </div>
  </main>
</Layout>

<script>
  import { supabase, loginConGoogle } from '../lib/supabase';

  let isLogin = true;

  const form = document.getElementById('auth-form') as HTMLFormElement;
  const title = document.getElementById('auth-title');
  const subtitle = document.getElementById('auth-subtitle');
  const submitBtn = document.getElementById('submit-btn');
  const toggleBtn = document.getElementById('toggle-mode-btn');
  const toggleText = document.getElementById('toggle-text');
  const errorMsg = document.getElementById('error-message');
  const googleBtn = document.getElementById('google-login-btn');

  // Redirigir si ya está logueado
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) {
      window.location.href = '/perfil';
    }
  });

  googleBtn?.addEventListener('click', loginConGoogle);

  toggleBtn?.addEventListener('click', () => {
    isLogin = !isLogin;
    if (isLogin) {
      if(title) title.innerText = 'Inicia Sesión';
      if(subtitle) subtitle.innerText = 'Accede a tu cuenta de Freedom para continuar tu entrenamiento.';
      if(submitBtn) submitBtn.innerText = 'Entrar a mi cuenta';
      if(toggleText) toggleText.innerText = '¿No tienes cuenta?';
      if(toggleBtn) toggleBtn.innerText = 'Regístrate gratis';
    } else {
      if(title) title.innerText = 'Crea tu Cuenta';
      if(subtitle) subtitle.innerText = 'Únete al Freedom Movement Lab y rompe tus límites.';
      if(submitBtn) submitBtn.innerText = 'Crear cuenta ahora';
      if(toggleText) toggleText.innerText = '¿Ya tienes cuenta?';
      if(toggleBtn) toggleBtn.innerText = 'Inicia sesión';
    }
    if(errorMsg) errorMsg.classList.add('hidden');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if(errorMsg) errorMsg.classList.add('hidden');
    
    // UI Loading state
    const originalBtnText = submitBtn?.innerText;
    if(submitBtn) {
      submitBtn.innerText = 'Cargando...';
      submitBtn.setAttribute('disabled', 'true');
    }

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    let authError = null;

    if (isLogin) {
      // Intentar login
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      authError = error;
    } else {
      // Intentar registro
      const { error } = await supabase.auth.signUp({ email, password });
      authError = error;
      
      if (!error) {
        // En supabase si tienes confirmación de correo habilitada, debes avisar.
        // Asumiremos para desarrollo que hace autologin o enviará un mail.
        alert('Cuenta creada. Si requieres confirmar el mail, revisa tu bandeja de entrada. Serás redirigido.');
      }
    }

    if (authError) {
      // Restaurar UI
      if(submitBtn) {
        submitBtn.innerText = originalBtnText || 'Intentar de nuevo';
        submitBtn.removeAttribute('disabled');
      }
      if(errorMsg) {
        errorMsg.innerText = isLogin ? 'Credenciales incorrectas o usuario no encontrado.' : 'Error al crear la cuenta. Intenta con otra contraseña.';
        errorMsg.classList.remove('hidden');
      }
    } else {
      window.location.href = '/perfil';
    }
  });
</script>
