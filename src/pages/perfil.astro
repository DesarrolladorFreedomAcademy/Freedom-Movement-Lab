---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

// Datos de Muestra - Perfil Fallback
const horasTotales = 0; // Se reemplazará con la cifra real BD

const user = {
  name: "Alex Parker",
  title: "Cargando Nivel...",
  joined: "ene. 2023",
  rank: 124,
  isPro: true,
  avatar: "https://ui-avatars.com/api/?name=Alex+Parker&background=00A3FF&color=fff&size=200",
  hours: {
    total: horasTotales,
    weeklyIncrease: 5.2
  },
  skills: {
    total: 20,
    mastered: 15
  },
  streak: {
    current: 12,
    record: 12
  }
};

const LOGROS = [
  { id: 1, title: "Maestro del Backflip", date: "HACE 2 DÍAS", unlocked: true, icon: "flip" },
  { id: 2, title: "Pro del Wall Run", date: "HACE 1 SEMANA", unlocked: true, icon: "wall" },
  { id: 3, title: "Jefe del Kong Vault", date: "BLOQUEADO", unlocked: false, icon: "kong" }
];

const HISTORIAL = []; // Ahora se carga de forma dinámica

const PROGRESO_HABILIDADES = [
  { name: "SALTOS DE OBSTÁCULOS (VAULTING)", percentage: 90 },
  { name: "CARRERAS POR LA PARED (WALL RUNS)", percentage: 65 },
  { name: "MORTALES Y CONCIENCIA AÉREA (FLIPS & AIR AWARENESS)", percentage: 40 }
];
---

<Layout title="Mi Perfil">
  <Nav />

  <!-- ===== TICKER DE NOTIFICACIONES ESTILO NOTICIERO ===== -->
  <div class="ticker-wrapper" id="ticker-section">
    <div class="ticker-container">
      <!-- Badge LIVE pulsante -->
      <div class="ticker-badge">
        <span class="ticker-live-dot"></span>
        <span class="ticker-live-text">EN VIVO</span>
      </div>
      
      <!-- Cinta de noticias con marquesina -->
      <div class="ticker-content" id="ticker-content">
        <div class="ticker-track" id="ticker-track">
          <!-- Se rellena dinámicamente con JS -->
          <span class="ticker-item ticker-placeholder">
            <svg class="ticker-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Cargando notificaciones...
          </span>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    /* ===== TICKER NOTICIERO ===== */
    .ticker-wrapper {
      position: sticky;
      top: 56px; /* justo debajo del nav */
      z-index: 40;
      width: 100%;
      background: linear-gradient(135deg, rgba(17,28,42,0.95) 0%, rgba(15,23,42,0.98) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(0,163,255,0.15);
      box-shadow: 0 4px 30px rgba(0,0,0,0.3), inset 0 1px 0 rgba(0,163,255,0.08);
      overflow: hidden;
    }
    .ticker-container {
      display: flex;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      height: 44px;
    }
    /* Badge EN VIVO */
    .ticker-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 0 16px 0 20px;
      flex-shrink: 0;
      height: 100%;
      background: linear-gradient(135deg, rgba(0,163,255,0.12) 0%, rgba(0,229,255,0.06) 100%);
      border-right: 1px solid rgba(0,163,255,0.2);
    }
    .ticker-live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 8px #ef4444, 0 0 16px rgba(239,68,68,0.4);
      animation: livePulse 1.5s ease-in-out infinite;
    }
    .ticker-live-text {
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #00A3FF;
      text-shadow: 0 0 10px rgba(0,163,255,0.3);
    }
    /* Contenido del ticker */
    .ticker-content {
      flex: 1;
      overflow: hidden;
      position: relative;
      height: 100%;
      display: flex;
      align-items: center;
      mask-image: linear-gradient(to right, transparent, black 40px, black calc(100% - 40px), transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 40px, black calc(100% - 40px), transparent);
    }
    .ticker-track {
      display: flex;
      align-items: center;
      white-space: nowrap;
      animation: tickerScroll var(--ticker-duration, 30s) linear infinite;
      will-change: transform;
    }
    .ticker-track:hover {
      animation-play-state: paused;
    }
    .ticker-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0 24px;
      font-size: 13px;
      font-weight: 600;
      color: #cbd5e1;
      position: relative;
      cursor: default;
      transition: color 0.2s;
    }
    .ticker-item:hover {
      color: #ffffff;
    }
    .ticker-item::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: rgba(0,163,255,0.5);
    }
    .ticker-item:last-child::after {
      display: none;
    }
    .ticker-item-icon {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      color: #00A3FF;
    }
    .ticker-item-new {
      color: #00E5FF;
      font-weight: 700;
    }
    .ticker-item-new .ticker-item-icon {
      color: #00E5FF;
      filter: drop-shadow(0 0 4px rgba(0,229,255,0.4));
    }
    .ticker-placeholder {
      color: #475569;
    }

    /* Keyframes */
    @keyframes tickerScroll {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @keyframes livePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%      { opacity: 0.5; transform: scale(0.85); }
    }

    /* Responsive */
    @media (max-width: 768px) {
      .ticker-badge {
        padding: 0 10px 0 12px;
      }
      .ticker-live-text {
        font-size: 9px;
      }
      .ticker-item {
        font-size: 12px;
        padding: 0 18px;
      }
      .ticker-container {
        height: 38px;
      }
    }
  </style>
  
  <main class="w-full min-h-screen pb-20 mt-8">
    <div class="container mx-auto px-8 max-w-[1200px] animate-fade-in">
      
      <!-- User Info Header Card -->
      <section id="profile-header-card" class="bg-[#111C2A] border border-white/5 rounded-3xl p-8 mb-8 flex flex-col md:flex-row items-center justify-between shadow-xl shadow-black/20 transition-all duration-500">
        <div class="flex items-center gap-6">
          <div class="relative">
            <!-- Avatar Ring -->
            <div id="profile-avatar-ring" class="w-28 h-28 rounded-full bg-gradient-to-tr from-[#00A3FF] to-[#00E5FF] p-1 shadow-[0_0_20px_rgba(0,163,255,0.4)] transition-all duration-500">
              <div class="w-full h-full bg-[#0F172A] rounded-full overflow-hidden border-4 border-[#0F172A]">
                <img id="profile-avatar" src={user.avatar} alt={user.name} class="w-full h-full object-cover" />
              </div>
            </div>
            <div id="profile-coach-badge" class="hidden absolute -bottom-2 right-1 bg-gradient-to-r from-[#EAB308] to-[#FDE047] text-black text-[10px] font-black uppercase px-3 py-1 rounded-full shadow-[0_0_15px_rgba(234,179,8,0.5)] border border-[#FEF08A]">
              COACH
            </div>
          </div>
          
          <div>
            <h1 id="profile-name" class="text-3xl font-black text-white mb-1">{user.name}</h1>
            <div class="flex items-center gap-2 text-[#00A3FF] font-medium mb-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg> 
              <span id="profile-title">{user.title}</span>
            </div>
            <div class="text-sm font-medium text-slate-400 flex items-center gap-3">
              <span id="profile-joined">Miembro desde {user.joined}</span>
            </div>
          </div>
        </div>
        
        <div class="mt-6 md:mt-0 flex items-center gap-3">
          <button id="btn-edit-profile" class="btn-primary flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
            Editar Perfil
          </button>
          <button id="btn-logout" class="bg-slate-800 hover:bg-rose-500/20 text-slate-300 hover:text-rose-400 border border-white/10 hover:border-rose-500/30 transition-colors px-4 py-3 rounded-full font-bold text-sm h-12 flex items-center justify-center gap-2 whitespace-nowrap min-w-fit shadow-[0_0_15px_rgba(0,0,0,0.5)] active:scale-95">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span class="hidden md:inline">Cerrar Sesión</span>
          </button>
        </div>
      </section>

      <!-- Stats Grid -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <!-- Horas de entrenamiento -->
        <div class="bg-[#111C2A] border border-[#00A3FF]/20 rounded-2xl p-6 relative overflow-hidden group hover:border-[#00A3FF]/40 transition-colors">
          <svg class="absolute right-[-10px] top-[-10px] w-32 h-32 text-slate-800/30 group-hover:text-slate-700/30 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          
          <h3 class="text-xs font-bold text-slate-400 tracking-wider mb-2 relative z-10">HORAS DE ENTRENAMIENTO</h3>
          <div id="profile-hours" class="text-5xl font-black text-white mb-2 relative z-10">{user.hours.total}</div>
          <div class="flex items-end justify-between relative z-10">
            <span id="profile-weekly-inc" class="text-sm font-semibold text-emerald-400 flex items-center gap-1">
               <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
              +{user.hours.weeklyIncrease}h esta semana
            </span>
            <!-- Mini Chart Mock -->
            <div class="flex items-end gap-1 h-8">
               <div class="w-2 bg-[#00A3FF]/40 h-[40%] rounded-t-sm"></div>
               <div class="w-2 bg-[#00A3FF]/40 h-[60%] rounded-t-sm"></div>
               <div class="w-2 bg-[#00A3FF]/60 h-[50%] rounded-t-sm"></div>
               <div class="w-2 bg-[#00A3FF]/80 h-[80%] rounded-t-sm"></div>
               <div class="w-2 bg-[#00A3FF] h-[100%] max-h-full rounded-t-sm shadow-[0_0_8px_#00A3FF]"></div>
            </div>
          </div>
        </div>

        <!-- Habilidades Dominadas -->
        <div class="bg-[#111C2A] border border-white/5 rounded-2xl p-6 relative overflow-hidden group hover:border-white/10 transition-colors">
          <svg class="absolute right-[-10px] top-[-10px] w-32 h-32 text-slate-800/30 group-hover:text-slate-700/30 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>

          <h3 class="text-xs font-bold text-slate-400 tracking-wider mb-2 relative z-10">HABILIDADES DOMINADAS</h3>
          <div class="flex items-baseline gap-1 relative z-10">
            <span class="text-5xl font-black text-white">{user.skills.mastered}</span>
            <span class="text-2xl font-bold text-slate-500">/{user.skills.total}</span>
          </div>
          
          <div class="mt-4 flex items-center justify-between relative z-10">
             <span class="text-sm font-semibold text-[#00A3FF]">+{Math.round((user.skills.mastered / user.skills.total) * 100)}% Completado</span>
             <!-- Circular Progress Mock -->
             <div class="relative w-12 h-12 flex items-center justify-center">
               <svg class="w-full h-full transform -rotate-90">
                 <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="4" fill="transparent" class="text-slate-700" />
                 <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="4" fill="transparent" class="text-[#00A3FF]" stroke-dasharray="125" stroke-dashoffset={125 - (125 * 0.75)} stroke-linecap="round" />
               </svg>
               <span class="absolute text-[10px] font-bold text-white">75%</span>
             </div>
          </div>
        </div>

        <!-- Racha Semanal -->
        <div class="bg-[#111C2A] border border-white/5 rounded-2xl p-6 relative overflow-hidden group hover:border-white/10 transition-colors">
           <svg class="absolute right-[-10px] top-[-10px] w-32 h-32 text-slate-800/30 group-hover:text-slate-700/30 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z"/></svg>

          <h3 class="text-xs font-bold text-slate-400 tracking-wider mb-2 relative z-10">RACHA SEMANAL</h3>
          <div class="flex items-baseline gap-2 relative z-10 mb-2">
             <span id="profile-streak" class="text-5xl font-black text-white">{user.streak.current}</span>
             <span class="text-lg font-bold text-slate-500">Días</span>
          </div>
          
          <div class="flex items-center justify-between mt-4 relative z-10">
            <span class="text-sm font-bold text-orange-500 flex items-center gap-1">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z"/></svg>
              ¡Mejor marca personal!
            </span>
            <!-- Dots Mock -->
            <div class="flex gap-1">
              <span class="w-2.5 h-2.5 rounded-full bg-[#00A3FF] shadow-[0_0_8px_#00A3FF]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#00A3FF] shadow-[0_0_8px_#00A3FF]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#00A3FF] shadow-[0_0_8px_#00A3FF]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- Grid 2 cols for Logros y Historial -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
        
        <!-- Mis Logros -->
        <div>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold flex items-center gap-2 text-white">
              <svg class="w-5 h-5 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8"/><path d="M12 17v4"/><path d="M19 4H5c-1.1 0-2 .9-2 2v4c0 4.4 3.6 8 8 8s8-3.6 8-8V6c0-1.1-.9-2-2-2z"/></svg>
              Mis Logros
            </h2>
            <a href="#" class="text-sm font-semibold text-[#00A3FF] hover:text-[#00E5FF] transition-colors">Ver Todo</a>
          </div>

          <div class="grid grid-cols-3 gap-4">
            {LOGROS.map((logro) => (
              <div class={`flex flex-col items-center justify-center p-4 rounded-2xl border transition-all cursor-pointer ${logro.unlocked ? 'bg-[#111C2A] border-[#00A3FF]/20 hover:border-[#00A3FF]/50 shadow-lg shadow-[#00A3FF]/5' : 'bg-[#0F172A] border-white/5 opacity-60 grayscale hover:grayscale-0 hover:opacity-100'}`}>
                 <div class={`w-14 h-14 rounded-full flex items-center justify-center mb-3 ${logro.unlocked ? 'bg-[#00A3FF]/10 text-[#00A3FF] border border-[#00A3FF]/30 shadow-[0_0_15px_rgba(0,163,255,0.2)]' : 'bg-slate-800 text-slate-500 border border-slate-700'}`}>
                   {logro.icon === 'flip' && <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                   {logro.icon === 'wall' && <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>}
                   {logro.icon === 'kong' && <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>}
                 </div>
                 <h3 class="text-[11px] md:text-xs font-bold text-center text-white mb-1 leading-tight">{logro.title}</h3>
                 <span class="text-[9px] md:text-[10px] font-bold uppercase tracking-wider text-slate-500">{logro.unlocked ? `DESBLOQUEADO` : 'BLOQUEADO'}</span>
                 {logro.unlocked && <span class="text-[9px] text-slate-600 mt-0.5">{logro.date}</span>}
              </div>
            ))}
          </div>
        </div>

        <!-- Historial de Entrenamiento -->
        <div>
           <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold flex items-center gap-2 text-white">
              <svg class="w-5 h-5 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Historial de Entrenamiento
            </h2>
            <a href="#" class="text-sm font-semibold text-[#00A3FF] hover:text-[#00E5FF] transition-colors text-right">Registros<br/>completos</a>
          </div>

          <div class="space-y-3" id="profile-historial-list">
            <div class="animate-pulse flex space-x-4 bg-[#111C2A] p-4 rounded-2xl border border-white/5">
              <div class="rounded-full bg-slate-700 h-10 w-10"></div>
              <div class="flex-1 space-y-2 py-1">
                <div class="h-3 bg-slate-700 rounded w-3/4"></div>
                <div class="space-y-2">
                  <div class="h-2 bg-slate-700 rounded w-1/2"></div>
                </div>
              </div>
            </div>
            <!-- El contenido real será inyectado por JS -->
          </div>
        </div>
      </div>

      <!-- Progreso de Habilidades -->
      <section>
        <div class="flex items-center mb-6">
          <h2 class="text-xl font-bold flex items-center gap-2 text-white">
            <svg class="w-5 h-5 text-[#00A3FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            Progreso de Habilidades
          </h2>
        </div>

        <div class="bg-[#111C2A] border border-white/5 rounded-2xl p-6 md:p-8 space-y-6">
          {PROGRESO_HABILIDADES.map((skill) => (
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-400 mb-2 tracking-widest uppercase">
                <span>{skill.name}</span>
                <span class="text-white">{skill.percentage}%</span>
              </div>
              <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden shadow-inner">
                 <div class="h-full bg-gradient-to-r from-[#00A3FF] to-[#00E5FF] rounded-full transition-all duration-1000 ease-out" style={`width: ${skill.percentage}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== PANEL INSTRUCTOR / ADMIN: Subida de Vídeos ===== -->
      <!-- Oculto por defecto, sólo visible si rol = instructor | admin -->
      <section id="upload-panel" class="hidden mt-12 mb-6 animate-fade-in relative z-10 w-full max-w-4xl mx-auto">
        <div class="flex items-center justify-center gap-3 mb-8 text-center flex-col md:flex-row">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#EAB308] to-[#FACC15] flex items-center justify-center text-black shadow-[0_0_20px_rgba(234,179,8,0.4)]">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/><path d="M16 16l-4-4-4 4"/></svg>
          </div>
          <div>
            <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">STUDIO CREADOR</h2>
            <span id="upload-panel-badge" class="text-[10px] font-black uppercase tracking-wider text-[#EAB308] px-2 py-0.5 mt-1 block text-center md:text-left">ACCESO COACH</span>
          </div>
        </div>

        <div class="bg-[#0b1016] border border-white/10 shadow-2xl shadow-black/80 rounded-[2rem] p-6 md:p-10 space-y-6 relative overflow-hidden backdrop-blur-xl">
          
          <!-- Estado del proceso -->
          <div id="upload-status" class="hidden items-center gap-3 p-4 rounded-xl border">
            <div id="upload-spinner" class="w-5 h-5 border-2 border-[#00A3FF] border-t-transparent rounded-full animate-spin hidden"></div>
            <svg id="upload-check" class="w-5 h-5 text-emerald-400 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="16 8 12 16 8 13"/></svg>
            <svg id="upload-error-icon" class="w-5 h-5 text-red-400 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <p id="upload-status-text" class="text-sm font-medium text-slate-300"></p>
          </div>

          <!-- Formulario de Metadatos -->
          <form id="upload-form" class="grid grid-cols-1 md:grid-cols-2 gap-5">
