<script>
  import { supabase } from '../lib/supabase';

  // ===== TICKER DE NOTIFICACIONES =====
  interface TickerNotification {
    texto: string;
    tipo: 'info' | 'logro' | 'video' | 'racha' | 'sistema';
    nuevo: boolean;
  }

  const ICONOS_TICKER: Record<string, string> = {
    info:    '<svg class="ticker-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>',
    logro:   '<svg class="ticker-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8"/><path d="M12 17v4"/><path d="M19 4H5c-1.1 0-2 .9-2 2v4c0 4.4 3.6 8 8 8s8-3.6 8-8V6c0-1.1-.9-2-2-2z"/></svg>',
    video:   '<svg class="ticker-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
    racha:   '<svg class="ticker-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z"/></svg>',
    sistema: '<svg class="ticker-item-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>',
  };

  // Notificaciones fallback si el usuario no sigue a nadie o no está logueado
  const NOTIFICACIONES_DEFAULT: TickerNotification[] = [
    { texto: '¡Bienvenido/a a Freedom Movement! Tu viaje comienza ahora.', tipo: 'sistema', nuevo: true },
    { texto: 'Explora el catálogo y sigue a tus instructores favoritos para recibir notificaciones aquí.', tipo: 'info', nuevo: true },
    { texto: 'Domina tus habilidades con sesiones de alta intensidad dirigidas por expertos.', tipo: 'sistema', nuevo: false },
    { texto: '¡El movimiento es libertad! Entrena cada día para superarte.', tipo: 'racha', nuevo: false },
  ];

  function renderTicker(notificaciones: TickerNotification[]) {
    const track = document.getElementById('ticker-track');
    if (!track || notificaciones.length === 0) return;

    // Construir ítems
    const itemsHtml = notificaciones.map(n => {
      const icon = ICONOS_TICKER[n.tipo] || ICONOS_TICKER.info;
      const extraClass = n.nuevo ? ' ticker-item-new' : '';
      return `<span class="ticker-item${extraClass}">${icon}${n.texto}</span>`;
    }).join('');

    // Duplicamos suficientes veces para asegurarnos de que el texto sobrepase pantallas muy anchas.
    // Usamos 20 repeticiones. Como la animación en CSS mueve el -50% (translateX), estará desplazando exactamente 10 bloques.
    const repeticiones = 20;
    track.innerHTML = itemsHtml.repeat(repeticiones);

    // Ajustar velocidad según número de ítems para que sea fluida
    let segundosPorBloque = notificaciones.length * 5; 
    // Mínimo de tiempo por bloque si hay muy pocos items para que no parezca que van volando
    if (segundosPorBloque < 20) segundosPorBloque = 20; 
    
    // Al trasladar -50%, movemos la mitad de los bloques (10 bloques en este caso)
    const duracionTotal = segundosPorBloque * (repeticiones / 2);
    
    track.style.setProperty('--ticker-duration', `${duracionTotal}s`);
    track.style.animationDuration = `${duracionTotal}s`;
  }

  // Función auxiliar para calcular tiempo relativo en español
  function tiempoRelativo(fechaStr: string): string {
    const ahora = new Date();
    const fecha = new Date(fechaStr);
    const diffMs = ahora.getTime() - fecha.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHoras = Math.floor(diffMins / 60);
    const diffDias = Math.floor(diffHoras / 24);

    if (diffMins < 1) return 'Ahora mismo';
    if (diffMins < 60) return `Hace ${diffMins} min`;
    if (diffHoras < 24) return `Hace ${diffHoras}h`;
    if (diffDias === 1) return 'Ayer';
    if (diffDias < 7) return `Hace ${diffDias} días`;
    if (diffDias < 30) return `Hace ${Math.floor(diffDias / 7)} sem.`;
    return fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
  }

  async function cargarNotificacionesTicker(userId?: string) {
    let notificaciones: TickerNotification[] = [];

    if (userId) {
      try {
        // 1. Obtener instructores que sigue el usuario
        const { data: seguimientos, error: segError } = await supabase
          .from('seguimientos')
          .select('instructor_nombre')
          .eq('usuario_id', userId);

        if (!segError && seguimientos && seguimientos.length > 0) {
          const nombresInstructores = seguimientos.map(s => s.instructor_nombre);

          // 2. Obtener los vídeos recientes de esos instructores (últimos 30 días)
          const hace30Dias = new Date();
          hace30Dias.setDate(hace30Dias.getDate() - 30);

          const { data: videos, error: vidError } = await supabase
            .from('videos')
            .select('id, titulo, instructor, creado_en')
            .eq('estado', 'listo')
            .in('instructor', nombresInstructores)
            .gte('creado_en', hace30Dias.toISOString())
            .order('creado_en', { ascending: false })
            .limit(20);

          if (!vidError && videos && videos.length > 0) {
            // 3. Obtener cuáles ya fueron marcados como vistos
            let idsVistos: Set<string> = new Set();
            try {
              const videoIds = videos.map((v: any) => v.id);
              const { data: vistos } = await supabase
                .from('notificaciones_vistas')
                .select('video_id')
                .eq('usuario_id', userId)
                .in('video_id', videoIds);

              if (vistos) {
                vistos.forEach((v: any) => idsVistos.add(v.video_id));
              }
            } catch (e) {
              // Tabla no existe aún, tratar todo como no visto
            }

            // Convertir vídeos en notificaciones
            notificaciones = videos.map((v: any) => ({
              texto: `${v.instructor} ha publicado: "${v.titulo}" · ${tiempoRelativo(v.creado_en)}`,
              tipo: 'video' as const,
              nuevo: !idsVistos.has(v.id), // Nuevo = no marcado como visto
            }));
          }

          // 4. Si hay seguimientos pero no hay vídeos recientes
          if (notificaciones.length === 0 && nombresInstructores.length > 0) {
            notificaciones = [
              { texto: `Sigues a ${nombresInstructores.length} instructor${nombresInstructores.length > 1 ? 'es' : ''}. Aquí aparecerán sus nuevos vídeos.`, tipo: 'info', nuevo: false },
              { texto: 'Tus instructores aún no han publicado contenido reciente. ¡Estate atento!', tipo: 'sistema', nuevo: false },
            ];
          }
        }
      } catch (e) {
        console.log('Error cargando notificaciones de seguimientos:', e);
      }
    }

    // Fallback si no hay datos reales
    if (notificaciones.length === 0) {
      notificaciones = NOTIFICACIONES_DEFAULT;
    }

    renderTicker(notificaciones);
  }

  // Lógica del Enfoque 1: Clásico Parkour / Traceur (Cliente)
  function obtenerTituloPorHoras(horas: number) {
    if (horas < 10) return "Aprendiz de Movimiento";
    if (horas < 30) return "Traceur en Formación";
    if (horas < 70) return "Traceur";
    if (horas < 150) return "Traceur Avanzado";
    if (horas < 500) return "Traceur de Élite";
    return "Maestro del Movimiento";
  }

  async function loadUserProfile() {
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session && session.user) {
      const meta = session.user.user_metadata;
      
      const nameEl = document.getElementById('profile-name');
      const avatarEl = document.getElementById('profile-avatar') as HTMLImageElement;
      const titleEl = document.getElementById('profile-title');
      const hoursEl = document.getElementById('profile-hours');
      const joinedEl = document.getElementById('profile-joined');
      
      // Fallback: Si no hay full_name usa el email antes del @
      const nombreUsuario = meta?.full_name || session.user.email?.split('@')[0] || 'Usuario';
      const defaultAvatarUrl = meta?.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(nombreUsuario)}&background=00A3FF&color=fff&size=200`;
      
      if (nameEl) nameEl.textContent = nombreUsuario;
      if (avatarEl) avatarEl.src = defaultAvatarUrl;

      // ---- Lógica del Modal (Pop-up) de Edición de Perfil ----
      const btnEditProfile = document.getElementById('btn-edit-profile');
      const editModal = document.getElementById('edit-profile-modal') as HTMLDialogElement;
      const btnCloseProfileModal = document.getElementById('btn-close-profile-modal');
      const editForm = document.getElementById('edit-profile-form') as HTMLFormElement;
      const idNameMap = document.getElementById('edit-name-input') as HTMLInputElement;
      const avatarUpload = document.getElementById('edit-avatar-upload') as HTMLInputElement;
      const btnRemoveAvatar = document.getElementById('btn-remove-avatar') as HTMLButtonElement;
      const errBox = document.getElementById('edit-profile-error');
      const btnSave = document.getElementById('btn-save-profile') as HTMLButtonElement;

      let fileToRemove = false; // Bandera para saber si borraran la foto manualmente

      if (btnEditProfile && editModal && editForm) {
        btnEditProfile.addEventListener('click', () => {
          idNameMap.value = nombreUsuario;
          avatarUpload.value = ''; // Limpiar input file
          fileToRemove = false;
          
          if (meta?.avatar_url) {
             btnRemoveAvatar.classList.remove('hidden');
          } else {
             btnRemoveAvatar.classList.add('hidden');
          }

          if (errBox) errBox.classList.add('hidden');
          editModal.showModal();
        });

        btnRemoveAvatar.addEventListener('click', () => {
          fileToRemove = true;
          avatarUpload.value = '';
          btnRemoveAvatar.classList.add('hidden');
          btnRemoveAvatar.textContent = 'Borrando...';
        });

        btnCloseProfileModal?.addEventListener('click', () => {
          editModal.close();
        });

        editForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          btnSave.disabled = true;
          btnSave.textContent = 'Guardando...';

          let updName = idNameMap.value.trim();
          let finalAvatarUrl = meta?.avatar_url || null; // Por defecto la actual si no se toca
          const file = avatarUpload?.files?.[0];

          if (fileToRemove) {
             finalAvatarUrl = null;
          }

          // Si seleccionan archivo nuevo, subir a storage
          if (file) {
             btnSave.textContent = 'Subiendo imagen...';
             const fileExt = file.name.split('.').pop();
             const fileName = `user-${session.user.id}-${Date.now()}.${fileExt}`;

             const { data: uploadData, error: uploadError } = await supabase.storage
               .from('avatars')
               .upload(fileName, file, { upsert: true });

             if (uploadError) {
               if (errBox) {
                 errBox.classList.remove('hidden');
                 errBox.textContent = 'Error subiendo la imagen al Bucket: ' + uploadError.message;
                 btnSave.disabled = false;
                 btnSave.textContent = 'Guardar';
               }
               return; // Detenemos
             }

             // Obtener url publica real (no expirada)
             const { data: { publicUrl } } = supabase.storage
               .from('avatars')
               .getPublicUrl(fileName);

             finalAvatarUrl = `${publicUrl}?t=${Date.now()}`; // añadir t para recargar la cache imagen nueva
          }

          btnSave.textContent = 'Guardando datos...';
          
          // 1. Actualizar metadatos de Autenticación
          const { error: authError } = await supabase.auth.updateUser({
            data: { 
              full_name: updName,
              avatar_url: finalAvatarUrl 
            }
          });

          if (authError) {
             if (errBox) {
               errBox.classList.remove('hidden');
               errBox.textContent = 'Error en Auth: ' + authError.message;
             }
             btnSave.disabled = false;
             btnSave.textContent = 'Guardar';
             return;
          }

          // 2. Sincronizar con la tabla pública "perfiles" (indispensable para el foro/comunidad)
          const { error: profileError } = await supabase
            .from('perfiles')
            .update({
              nombre: updName,
              avatar_url: finalAvatarUrl
            })
            .eq('id', session.user.id);

          if (profileError) {
             console.error('Error sincronizando tabla perfiles:', profileError);
             // No bloqueamos el reload si auth funcionó, pero avisamos en consola
          }

          window.location.reload(); 
        });
      }
      // --------------------------------------------------------
      
      if (joinedEl && session.user.created_at) {
        const fecha = new Date(session.user.created_at);
        const mes = fecha.toLocaleString('es-ES', { month: 'short' }).replace('.', '');
        const anio = fecha.getFullYear();
        joinedEl.textContent = `Miembro desde ${mes}. ${anio}`;
      }

      // 2. Cargar las notificaciones del ticker
      cargarNotificacionesTicker(session.user.id);

      // 1. Obtener datos extra desde Supabase -> Tabla "perfiles" (horas + rol)
      try {
        const { data: perfilData } = await supabase
          .from('perfiles')
          .select('horas_entrenamiento, rol')
          .eq('id', session.user.id)
          .maybeSingle();
          
        // Obtener historial de videos con detalle para las tres tareas: Horas Semanales, Racha y Listado
        const { data: historialData } = await supabase
          .from('historial_videos')
          .select('tiempo_actual, actualizado_en, completado, video_id, videos(id, titulo, duracion)')
          .eq('usuario_id', session.user.id)
          .order('actualizado_en', { ascending: false });

        let weeklySeconds = 0;
        let rachaSemanal = 0;

        if (historialData) {
          const now = new Date();
          // Inicio de semana (Lunes)
          const jsDay = now.getDay();
          const day = jsDay === 0 ? 6 : jsDay - 1; 
          const startOfWeek = new Date(now);
          startOfWeek.setDate(now.getDate() - day);
          startOfWeek.setHours(0,0,0,0);

          const daysWithVideos = new Set();
          
          historialData.forEach(item => {
            const date = new Date(item.actualizado_en);
            
            // Hrs semanales
            if (date >= startOfWeek) {
              weeklySeconds += (Number(item.tiempo_actual) || 0);
            }
            
            // Racha
            const dateStr = date.toISOString().split('T')[0];
            daysWithVideos.add(dateStr);
          });

          const horasSemana = Math.floor(weeklySeconds / 3600);
          const horasTotales = (perfilData?.horas_entrenamiento || 0) + horasSemana;

          // Cálculo Racha
          let streak = 0;
          let checkDate = new Date(now);
          checkDate.setHours(0,0,0,0);
          
          let dateStr = checkDate.toISOString().split('T')[0];
          
          // Allow yesterday to keep streak if today is 0
          if (!daysWithVideos.has(dateStr)) {
            checkDate.setDate(checkDate.getDate() - 1);
            dateStr = checkDate.toISOString().split('T')[0];
          }

          while (daysWithVideos.has(dateStr)) {
            streak++;
            checkDate.setDate(checkDate.getDate() - 1);
            dateStr = checkDate.toISOString().split('T')[0];
          }

          rachaSemanal = streak;

          // Actualizar UI
          if (hoursEl) hoursEl.textContent = horasSemana.toString();
          if (titleEl) titleEl.textContent = obtenerTituloPorHoras(horasTotales);
          
          const streakEl = document.getElementById('profile-streak');
          if (streakEl) streakEl.textContent = rachaSemanal.toString();
          
          const weeklyIncEl = document.getElementById('profile-weekly-inc');
          if (weeklyIncEl) weeklyIncEl.textContent = `+${Math.round(weeklySeconds/3600*10)/10}h esta semana`;

          // Inyectar Historial Completo Real
          const videosCompletados = historialData.filter((item: any) => item.completado === true);
          const histContainer = document.getElementById('profile-historial-list');

          function renderHistorialItem(item: any): string {
            const v = item.videos;
            if (!v) return '';
            const dur = v.duracion ? Math.floor(v.duracion / 60) + ' mins' : 'VOD';
            const isCompleted = item.completado ? 'Completado' : 'Pendiente';
            const dateObj = new Date(item.actualizado_en);
            const dateStr = dateObj.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' }).toUpperCase();
            return `
            <div class="historial-item flex items-center gap-4 bg-[#111C2A] border border-white/5 p-4 rounded-2xl hover:bg-slate-800/60 transition-colors group" data-video-id="${v.id}">
              <a href="/reproductor?id=${v.id}" class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-[#00A3FF]/10 text-[#00A3FF] hover:bg-[#00A3FF]/20 transition-colors">
                <svg class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </a>
              <a href="/reproductor?id=${v.id}" class="flex-grow min-w-0 cursor-pointer">
                <h4 class="font-bold text-sm text-slate-100 truncate group-hover:text-[#00A3FF] transition-colors">${v.titulo}</h4>
                <div class="text-xs text-slate-400 mt-1 flex gap-2 items-center">
                  <span>VOD</span>
                  <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                  <span>${dur}</span>
                  <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                  <span class="${item.completado ? 'text-emerald-400 font-bold' : 'text-slate-400'}">${isCompleted}</span>
                </div>
              </a>
              <div class="flex items-center gap-3 flex-shrink-0">
                <div class="text-[10px] font-bold tracking-widest text-slate-500 uppercase">${dateStr}</div>
                <button class="btn-unwatch opacity-0 group-hover:opacity-100 w-7 h-7 flex items-center justify-center rounded-full text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 transition-all" title="Marcar como no visto" data-video-id="${v.id}">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>
            </div>
            `;
          }

          if (histContainer) {
            if (videosCompletados.length === 0) {
               histContainer.innerHTML = '<p class="text-sm text-slate-500 py-4 text-center">Aún no has completado ningún vídeo.</p>';
            } else {
               histContainer.innerHTML = videosCompletados.slice(0, 5).map(renderHistorialItem).join('');
            }

            // Handler para los botones "Marcar como no visto"
            histContainer.addEventListener('click', async (e) => {
              const btn = (e.target as HTMLElement).closest('.btn-unwatch') as HTMLButtonElement | null;
              if (!btn) return;
              e.preventDefault();
              e.stopPropagation();

              const videoIdToUnwatch = btn.dataset.videoId;
              if (!videoIdToUnwatch) return;

              if (!confirm('¿Marcar este vídeo como no visto? Se eliminará de tu historial.')) return;

              btn.disabled = true;
              btn.innerHTML = '<svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/></svg>';

              try {
                const { data: { session: currentSession } } = await supabase.auth.getSession();
                const accessToken = currentSession?.access_token || '';

                const res = await fetch('/api/unwatch-video', {
                  method: 'DELETE',
                  headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${accessToken}`,
                  },
                  body: JSON.stringify({ videoId: videoIdToUnwatch }),
                });

                if (res.ok) {
                  // Animar y eliminar la tarjeta del DOM
                  const card = histContainer.querySelector(`.historial-item[data-video-id="${videoIdToUnwatch}"]`) as HTMLElement | null;
                  if (card) {
                    card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                    card.style.opacity = '0';
                    card.style.transform = 'translateX(20px)';
                    setTimeout(() => {
                      card.remove();
                      if (histContainer.children.length === 0) {
                        histContainer.innerHTML = '<p class="text-sm text-slate-500 py-4 text-center">Aún no has completado ningún vídeo.</p>';
                      }
                    }, 300);
                  }
                } else {
                  const result = await res.json();
                  alert('Error: ' + (result.error || 'No se pudo actualizar el historial'));
                  btn.disabled = false;
                  btn.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
                }
              } catch (err: any) {
                alert('Error de red: ' + err.message);
                btn.disabled = false;
                btn.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
              }
            });
          }
        }

        // 5. LÓGICA DE COACH
        const rol = perfilData?.rol || 'usuario';
        if (rol === 'instructor' || rol === 'admin') {
           // Insignia COACH
           const profileCard = document.getElementById('profile-header-card');
           if (profileCard) {
              profileCard.classList.add('border-[#EAB308]/30', 'shadow-[0_0_40px_rgba(234,179,8,0.15)]');
              profileCard.classList.remove('border-white/5', 'shadow-black/20');
           }
           const avatarRing = document.getElementById('profile-avatar-ring');
           if (avatarRing) {
             avatarRing.classList.replace('from-[#00A3FF]', 'from-[#EAB308]');
             avatarRing.classList.replace('to-[#00E5FF]', 'to-[#FDE047]');
             avatarRing.classList.replace('shadow-[0_0_20px_rgba(0,163,255,0.4)]', 'shadow-[0_0_20px_rgba(234,179,8,0.4)]');
           }
           const coachBadge = document.getElementById('profile-coach-badge');
           if (coachBadge) {
             coachBadge.textContent = rol === 'admin' ? 'ADMINISTRADOR' : 'INSTRUCTOR';
             coachBadge.classList.replace('hidden', 'inline-block');
           }
           
           if (titleEl) titleEl.textContent = rol === 'admin' ? 'Administrador' : 'Instructor';

           // Mostrar Panel de Subida
           const uploadPanel = document.getElementById('upload-panel');
           if (uploadPanel) {
              uploadPanel.classList.remove('hidden');
              uploadPanel.classList.add('block');
           }
           
           const uploadPanelBadge = document.getElementById('upload-panel-badge');
           if (uploadPanelBadge) {
             uploadPanelBadge.textContent = rol === 'admin' ? 'ACCESO ADMINISTRADOR' : 'ACCESO INSTRUCTOR';
           }

           inicializarUploader(session.user.id, nombreUsuario, defaultAvatarUrl);
        }
        
      } catch (err) {
        console.error("No se pudo cargar perfil BD", err);
      }
      
      // ===== LÓGICA DE ACTUALIZACIÓN DEL HISTORIAL (Real-Time SPA Simulation) =====
      // Escuchamos el evento emitido desde el reproductor cuando COMPLETAMOS un vídeo
      window.addEventListener('freedom:videoCompleted', async (e: any) => {
         const detail = e.detail;
         if (!detail || !detail.videoId) return;

         try {
           // Traemos los datos de ese vídeo específico desde la tabla videos para rellenar la ficha
           const { data: videoGuardado } = await supabase
             .from('videos')
             .select('id, titulo, duracion')
             .eq('id', detail.videoId)
             .single();
             
           if (!videoGuardado) return;

           const histContainer = document.getElementById('profile-historial-list');
           if (!histContainer) return;

           // Quitar el mensaje vacío si existía
           if (histContainer.innerHTML.includes('Aún no has visto')) {
             histContainer.innerHTML = '';
           }

           const dur = videoGuardado.duracion ? Math.floor(videoGuardado.duracion / 60) + ' mins' : 'VOD';
           const dateStr = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'short' }).toUpperCase();
           
           const nuevaFicha = `
           <a href="/reproductor?id=${videoGuardado.id}" class="flex items-center gap-4 bg-[#111C2A] border border-emerald-500/30 p-4 rounded-2xl hover:bg-slate-800 transition-colors cursor-pointer group animate-fade-in relative overflow-hidden">
             <!-- Destello de "Recién Añadido" -->
             <div class="absolute inset-0 bg-emerald-500/5 pointer-events-none"></div>
             
             <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-emerald-500/10 text-emerald-400">
               <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
             </div>
             <div class="flex-grow min-w-0">
               <h4 class="font-bold text-sm text-slate-100 truncate group-hover:text-emerald-400 transition-colors">${videoGuardado.titulo}</h4>
               <div class="text-xs text-slate-400 mt-1 flex gap-2 items-center">
                 <span class="text-emerald-400 font-bold uppercase tracking-wider text-[10px]">Nuevo</span>
                 <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                 <span>${dur}</span>
                 <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                 <span class="text-slate-400">Pendiente</span>
               </div>
             </div>
             <div class="text-[10px] font-bold tracking-widest text-slate-500 uppercase flex-shrink-0">
               ${dateStr}
             </div>
           </a>
           `;

           // Insertarlo arriba del todo
           histContainer.insertAdjacentHTML('afterbegin', nuevaFicha);
           
           // Si hay más de 5 en la lista, quitamos el último para no saturar 
           // (ya que por UI mostramos los 5 recientes)
           if (histContainer.children.length > 5) {
             histContainer.removeChild(histContainer.lastElementChild as Node);
           }

         } catch (error) {
           console.error('Error insertando render optimista', error);
         }
      });
      
    } else {
      // Sin sesión: mostrar ticker con datos fallback
      cargarNotificacionesTicker();
    }
  }

  // ===== Lógica del Uploader de Vídeo =====
  function inicializarUploader(usuarioId: string, instructorName: string, instructorAvatar: string) {
    const form = document.getElementById('upload-form') as HTMLFormElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const fileNameEl = document.getElementById('selected-file-name');
    const progressContainer = document.getElementById('progress-container');
    const progressBar = document.getElementById('progress-bar');
    const progressPct = document.getElementById('progress-pct');
    const uploadBtn = document.getElementById('upload-btn') as HTMLButtonElement;
    const statusEl = document.getElementById('upload-status');
    const statusText = document.getElementById('upload-status-text');
    const spinner = document.getElementById('upload-spinner');
    const checkIcon = document.getElementById('upload-check');
    const errorIcon = document.getElementById('upload-error-icon');

    // UI readonly del Instructor
    const uploaderAvatar = document.getElementById('upload-instructor-avatar') as HTMLImageElement;
    const uploaderName = document.getElementById('upload-instructor-name');
    if (uploaderAvatar) uploaderAvatar.src = instructorAvatar;
    if (uploaderName) uploaderName.textContent = instructorName;

    // Mostrar nombre del archivo seleccionado
    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file && fileNameEl) {
        fileNameEl.textContent = `📎 ${file.name}`;
        fileNameEl.classList.remove('hidden');
      }
    });

    function setStatus(tipo: 'loading' | 'success' | 'error', mensaje: string) {
      if (!statusEl || !statusText) return;
      statusEl.classList.remove('hidden');
      statusEl.classList.add('flex');
      statusText.textContent = mensaje;

      spinner?.classList.toggle('hidden', tipo !== 'loading');
      checkIcon?.classList.toggle('hidden', tipo !== 'success');
      errorIcon?.classList.toggle('hidden', tipo !== 'error');

      const colores = {
        loading: 'border-[#00A3FF]/20 bg-[#00A3FF]/5',
        success: 'border-emerald-400/20 bg-emerald-400/5',
        error: 'border-red-400/20 bg-red-400/5',
      };
      statusEl.className = statusEl.className.replace(/border-\S+|bg-\S+/g, '').trim();
      statusEl.classList.add(...colores[tipo].split(' '));
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const titulo = (document.getElementById('field-titulo') as HTMLInputElement)?.value;
      const descripcion = (document.getElementById('field-descripcion') as HTMLTextAreaElement)?.value;
      const instructor = instructorName; // Se asigna automáticamente del usuario autenticado
      const dificultad = (document.getElementById('field-dificultad') as HTMLSelectElement)?.value;
      const archivo = fileInput?.files?.[0];

      if (!titulo || !archivo) {
        setStatus('error', 'El título y el archivo de vídeo son obligatorios.');
        return;
      }

      uploadBtn.disabled = true;
      setStatus('loading', 'Solicitando URL de subida a Mux...');

      try {
        // Obtener el token de la sesión actual para enviarlo al servidor
        const { data: { session: currentSession } } = await supabase.auth.getSession();
        const accessToken = currentSession?.access_token || '';

        // 1. Solicitar URL de subida a nuestro API endpoint
        const res = await fetch('/api/upload-video', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${accessToken}`,
          },
          body: JSON.stringify({ titulo, descripcion, instructor, dificultad, usuarioId }),
        });

        if (!res.ok) throw new Error('No se pudo obtener la URL de subida.');

        const { uploadUrl } = await res.json();

        // 2. Subir el archivo directamente a Mux usando XHR (para progreso real)
        setStatus('loading', 'Subiendo vídeo a Mux...');
        progressContainer?.classList.remove('hidden');

        await new Promise<void>((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          xhr.open('PUT', uploadUrl);
          xhr.setRequestHeader('Content-Type', archivo.type);

          xhr.upload.addEventListener('progress', (e) => {
            if (e.lengthComputable) {
              const pct = Math.round((e.loaded / e.total) * 100);
              if (progressBar) progressBar.style.width = `${pct}%`;
              if (progressPct) progressPct.textContent = `${pct}%`;
            }
          });

          xhr.onload = () => {
            if (xhr.status >= 200 && xhr.status < 300) resolve();
            else reject(new Error(`Error de subida: ${xhr.status}`));
          };
          xhr.onerror = () => reject(new Error('Error de red al subir el archivo.'));
          xhr.send(archivo);
        });

        setStatus('success', '¡Vídeo subido con éxito! Mux lo está procesando. Estará disponible en el catálogo en unos minutos.');
        form.reset();
        if (fileNameEl) fileNameEl.classList.add('hidden');
        progressContainer?.classList.add('hidden');

      } catch (err: any) {
        setStatus('error', `Error: ${err.message}`);
      } finally {
        uploadBtn.disabled = false;
      }
    });
  }

  // --- Lógica de Cerrar Sesión ---
  const btnLogout = document.getElementById('btn-logout');
  if (btnLogout) {
    btnLogout.addEventListener('click', async () => {
      // Opcional: poner estado de carga visual en el botón
      const btnSpan = btnLogout.querySelector('span');
      if (btnSpan) btnSpan.textContent = 'Cerrando...';
      
      try {
        await supabase.auth.signOut();
        // Limpiamos caché local de notificaciones solo por si acaso
        localStorage.removeItem('fml_unread_notis');
        localStorage.removeItem('fml_noti_last_check');
        
        // Redirigir siempre a inicio al cerrar sesión con un hard reload
        window.location.href = '/';
      } catch (error) {
        console.error('Error cerrando sesión:', error);
        if (btnSpan) btnSpan.textContent = 'Cerrar Sesión';
      }
    });
  }

  loadUserProfile();
</script>
